/* ==========================================================================
   OVERCLOCK 2027 â€” DEDICATED MOBILE & TABLET STYLESHEET (mobile.css)
   
   Architecture:
   - Scoped strictly to viewports <= 1023px (tablets and phones).
   - Desktop viewports (>= 1024px) remain 100% untouched and pristine.
   - Reuses existing design tokens and CSS variables from styles.css.
   - Eliminates oversized, zoomed-in mobile appearance with balanced hierarchy:
       * Hero flap title: clamp(1.15rem, 5vw, 1.45rem)
       * Section headings: clamp(1.35rem, 4.8vw, 1.75rem) (23â€“28px)
       * Card headings: 1.05remâ€“1.20rem (17â€“20px)
       * Body text: 0.88remâ€“0.92rem (14â€“15px)
       * Technical labels: 0.68remâ€“0.75rem (11â€“12px)
       * Card internal padding: 12pxâ€“16px
       * Side gutters: 16pxâ€“20px (361â€“430px), 14px (320â€“360px)
   - Fixes Temporal Clock Navigator quarter-circle instrument at top-right.
   - Fixes floating Miss Minutes at bottom-right viewport anchor.
   ========================================================================== */

/* ==========================================================================
   1. TABLETS & COMPACT VIEWPORTS (<= 1023px)
   ========================================================================== */
@media screen and (max-width: 1023px) {

  /* --- Base Container & Gutters --- */
  html, body {
    overflow-x: hidden;
    width: 100%;
    position: relative;
  }

  .bureau-section {
    padding: 56px 20px 48px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .hero-bureau-section {
    padding-top: 24px;
    padding-bottom: 40px;
    min-height: calc(100vh - 60px);
    box-sizing: border-box;
  }

  /* --- Global Vintage Stamp Sizing --- */
  .section-rubber-stamp,
  .bureau-section .section-rubber-stamp {
    font-size: 0.74rem;
    padding: 3px 8px;
    letter-spacing: 0.08em;
    top: 8px;
    right: 14px;
    opacity: 0.85;
  }

  /* --- Section Typography Hierarchy --- */
  .section-header-wrap {
    margin-bottom: 22px;
    width: 100%;
  }

  .bureau-tag,
  .section-header-wrap .bureau-tag {
    font-size: 0.70rem;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    margin-bottom: 8px;
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    line-height: 1.35;
    box-sizing: border-box;
  }

  .section-main-heading {
    font-size: clamp(1.45rem, 4.6vw, 1.85rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .section-subtext {
    font-size: 0.90rem;
    line-height: 1.5;
    color: var(--text-dim, #C8B9A6);
    max-width: 100%;
    margin-bottom: 20px;
  }

  /* --- Navigation Bar --- */
  .bureau-navbar {
    height: 60px;
    background: rgba(20, 16, 12, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .nav-container {
    padding: 0 76px 0 16px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
  }

  .nav-brand-group {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    max-width: calc(100% - 90px);
    flex-shrink: 1;
    min-width: 0;
  }

  /* Secondary organization labels removed from mobile header to give OVERCLOCK breathing room */
  .brand-badge {
    display: none !important;
  }

  .brand-wordmark-wrap {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-shrink: 0;
  }

  .brand-wordmark {
    font-size: clamp(1.28rem, 4.8vw, 1.55rem);
    letter-spacing: 0.04em;
    font-family: var(--font-display);
    color: var(--amber-bright, #E8892B);
    line-height: 1;
    text-shadow: 0 0 10px rgba(232, 137, 43, 0.4);
  }

  .brand-year-tag {
    font-size: 0.88rem;
    font-family: var(--font-mono);
    color: var(--paper-cream, #EFE6D2);
  }

  .nav-actions-group {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-left: auto !important;
    flex-shrink: 0;
  }

  /* Remove crowded desktop-only actions, secondary tags, sound button, replay intro button & temporal-log readouts */
  .nav-timeline-status,
  .nav-desktop-cta,
  .nav-actions,
  .nav-audio-btn,
  .nav-replay-btn,
  .nav-links-menu,
  .mobile-menu-toggle {
    display: none !important;
  }

  /* Compact Unstop Registration Link in Mobile Header */
  .header-unstop-link {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    padding: 4px 8px !important;
    background: rgba(28, 20, 14, 0.95) !important;
    border: 1px solid rgba(217, 169, 58, 0.45) !important;
    border-radius: 4px !important;
    text-decoration: none !important;
    flex-shrink: 0 !important;
    transition: border-color 0.2s, background-color 0.2s !important;
  }

  .unstop-logo-chip {
    display: inline-flex !important;
    align-items: center !important;
    height: 16px !important;
  }

  .unstop-logo-chip .header-unstop-logo,
  .header-unstop-logo {
    height: 13px !important;
    width: auto !important;
    max-width: 48px !important;
    display: block !important;
  }

  .unstop-btn-text {
    font-family: var(--font-mono) !important;
    font-size: 0.68rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    color: #FFD27D !important;
    line-height: 1 !important;
  }

  .unstop-header-badge-tag {
    display: none !important;
  }

  /* --- Temporal Clock Navigator (Upper-Right Corner Precision Instrument) --- */
  .corner-clock-navigator {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .corner-dial-trigger,
  button.corner-dial-trigger,
  #corner-dial-trigger {
    position: fixed !important;
    top: -46px !important;
    right: -46px !important;
    width: 104px !important;
    height: 104px !important;
    z-index: 1000 !important;
    pointer-events: auto !important;
    border: 1.5px solid rgba(217, 169, 58, 0.65) !important;
    background: radial-gradient(circle at 100% 0%, #201710 0%, #17120F 70%, #130E0B 100%) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.85) !important;
    cursor: pointer;
    padding: 0 !important;
    margin: 0 !important;
    touch-action: manipulation !important;
  }

  .corner-dial-pointer {
    height: 34px !important;
  }

  .corner-dial-pointer .pointer-needle {
    height: 28px !important;
    width: 1.5px !important;
  }

  .corner-rotor-marker {
    transform: translate(-50%, -50%) rotate(var(--base-angle)) translateY(-34px) !important;
  }

  .corner-dial-ray {
    height: 52px !important;
  }

  /* Expanded Temporal Directory */
  .corner-temporal-menu,
  nav.corner-temporal-menu,
  #corner-temporal-menu {
    position: fixed !important;
    top: 58px !important;
    right: 8px !important;
    width: calc(100vw - 16px) !important;
    max-width: 310px !important;
    max-height: calc(100vh - 68px) !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    z-index: 1100 !important;
    background: #16110D !important;
    border: 1.5px solid var(--border-brass, #C89D42) !important;
    border-radius: 6px !important;
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.95) !important;
    padding: 10px 12px 14px !important;
    box-sizing: border-box !important;
  }

  .corner-temporal-menu .temporal-directory-wrapper {
    position: relative;
    padding-left: 14px;
  }

  .corner-temporal-menu .temporal-directory-wrapper::before {
    left: 4px;
    width: 2px;
  }

  .corner-temporal-menu .sector-box {
    min-height: 40px;
    padding: 7px 10px;
    margin-bottom: 6px;
    border: 1px solid rgba(217, 169, 58, 0.35);
    border-radius: 4px;
    background: rgba(28, 21, 15, 0.9);
    font-size: 0.80rem;
  }

  /* --- Floating Miss Minutes Mascot --- */
  .miss-minutes-overlay,
  #miss-minutes-overlay {
    position: fixed !important;
    bottom: calc(14px + env(safe-area-inset-bottom, 0px)) !important;
    right: calc(12px + env(safe-area-inset-right, 0px)) !important;
    left: auto !important;
    top: auto !important;
    transform: none !important;
    width: 48px !important;
    height: 48px !important;
    z-index: 950 !important;
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    background: transparent !important;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.75)) !important;
    border-radius: 50% !important;
    cursor: pointer !important;
    touch-action: manipulation !important;
  }

  .miss-minutes-speech,
  #miss-minutes-speech {
    display: none !important; /* Conceal bubble to prevent obscuring content */
  }

  /* --- Hero Section Elements --- */
  .hero-content-wrapper {
    width: 100%;
    max-width: 100%;
  }

  .hero-title-container {
    width: 100%;
    position: relative;
  }

  .hero-bureau-section .section-rubber-stamp {
    top: -6px;
    right: 0;
  }

  .split-flap-title {
    display: flex;
    justify-content: space-between;
    width: 100%;
    max-width: 360px;
    margin: 10px 0;
    gap: 3px;
  }

  .split-flap-title .flap-char-box,
  .hero-subhead,
  .hero-tagline,
  .typed-form-strip,
  .typed-form-strip .form-field-unit,
  .hero-cta-group > *,
  .hero-registration-pill {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  .split-flap-title .flap-char-box {
    flex: 1 1 0;
    min-width: 0;
    padding: 4px 0;
    font-size: clamp(1.15rem, 5vw, 1.45rem);
    border-width: 1.5px;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  .hero-subhead {
    font-size: clamp(0.92rem, 3.2vw, 1.05rem);
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .hero-tagline {
    font-size: clamp(0.85rem, 2.8vw, 0.92rem);
    line-height: 1.45;
    margin-bottom: 14px;
    color: var(--text-body, #EFE6D2);
  }

  .hero-clock-backdrop {
    width: min(240px, 65vw);
    height: min(240px, 65vw);
    opacity: 0.35;
  }

  /* Hero Intake Manifest Card */
  .typed-form-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 12px;
    padding: 12px 14px;
    margin-bottom: 16px;
    border: 1.5px solid var(--border-subtle, rgba(217, 169, 58, 0.3));
    border-radius: 6px;
    background: rgba(28, 21, 15, 0.92) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    width: 100%;
    max-width: 480px;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  }

  .typed-form-strip::before {
    font-size: 0.62rem;
    top: -9px;
    left: 12px;
    padding: 0 6px;
  }

  .typed-form-strip .form-field-unit {
    opacity: 1 !important;
    transform: none !important;
    gap: 1px;
  }

  .field-label {
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: var(--text-dim, #C8B9A6);
  }

  .field-value {
    font-size: 0.82rem;
    color: var(--text-bright, #FFF2DC);
  }

  .hero-cta-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 360px;
    margin-bottom: 10px;
  }

  .hero-cta-group .btn-bureau-brass {
    width: 100%;
    justify-content: center;
    font-size: 0.84rem;
    padding: 11px 16px;
    min-height: 44px;
    letter-spacing: 0.08em;
  }

  .hero-registration-pill {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    max-width: 360px !important;
    padding: 8px 14px !important;
    font-size: 0.72rem !important;
    letter-spacing: 0.06em !important;
    box-sizing: border-box !important;
    margin-top: 6px !important;
  }

  /* Organising Clubs Section & Cards */
  .clubs-cards-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* Downloads Resource Grid */
  .downloads-resource-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* Hero Prize Pill */
  .hero-prize-pill {
    padding: 8px 14px;
    font-size: 0.74rem;
  }
}

/* ==========================================================================
   2. PHONES & SMALL VIEWPORTS (<= 768px)
   ========================================================================== */
@media screen and (max-width: 768px) {

  /* Gutters & Margins for Standard Mobile */
  .bureau-section {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 48px;
    padding-bottom: 40px;
  }

  /* --- Section 02: About / Event Briefing --- */
  .operational-status-panel {
    padding: 14px 14px;
    margin-bottom: 16px;
    border: 1.5px solid var(--border-brass, #C89D42);
    border-radius: 6px;
    background: rgba(22, 17, 13, 0.9);
    box-sizing: border-box;
  }

  .panel-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(217, 169, 58, 0.25);
  }

  .panel-header-title {
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .panel-header-badge {
    font-size: 0.62rem;
    padding: 2px 6px;
    white-space: nowrap;
  }

  .status-readout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .status-cell {
    padding: 8px 10px;
    border: 1px solid rgba(217, 169, 58, 0.2);
    background: rgba(20, 15, 11, 0.7);
    border-radius: 4px;
    box-sizing: border-box;
  }

  .status-cell.span-full {
    grid-column: 1 / -1;
  }

  .status-k {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    margin-bottom: 2px;
    display: block;
    color: var(--text-dim, #C8B9A6);
  }

  .status-v {
    font-size: 0.80rem;
    line-height: 1.3;
    display: block;
  }

  .case-notes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .case-note-card {
    padding: 14px 14px;
    border: 1.5px solid var(--border-subtle, rgba(217, 169, 58, 0.3));
    border-radius: 6px;
    background: rgba(24, 18, 13, 0.85);
  }

  .note-stamp {
    font-size: 0.64rem;
    padding: 2px 6px;
    margin-bottom: 6px;
  }

  .note-title {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }

  .note-body {
    font-size: 0.84rem;
    line-height: 1.45;
  }

  /* --- Section 03: Problem Statements (Single Column, 6 Slots) --- */
  .domain-slots-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    width: 100%;
    margin: 0 auto;
  }

  .domain-slot-card {
    grid-column: auto !important;
    padding: 0 !important;
    border: 2px solid var(--border-dim);
    border-radius: var(--radius-md);
    background: #18120c;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
  }

  .domain-slot-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    height: 42px;
    margin-bottom: 0 !important;
    border-bottom: 1px solid rgba(217, 169, 58, 0.15);
    background: #130d08;
    box-sizing: border-box;
  }

  .slot-badge {
    font-size: 0.70rem;
    padding: 0;
  }

  .slot-freq {
    font-size: 0.68rem;
  }

  .domain-screen-display {
    padding: 12px 14px 8px;
    height: 100px;
    margin-bottom: 0 !important;
    border-radius: 0 !important;
    border-bottom: 1px solid var(--border-dim);
    box-sizing: border-box;
  }

  .screen-waveform-container {
    height: 50px;
    width: 100%;
    position: relative;
  }

  .waveform-svg {
    height: 34px;
  }

  .slot-channel-tag {
    font-size: 0.62rem;
    margin-top: 4px;
    text-align: right;
  }

  .slot-content-chamber {
    padding: 18px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
  }

  .slot-status-indicator {
    min-height: 30px;
    height: auto;
    font-size: 0.68rem;
    margin-bottom: 0;
  }

  .slot-title {
    font-size: 1.35rem;
    min-height: auto;
    margin: 0;
  }

  .slot-desc {
    font-size: 0.82rem;
    min-height: auto;
    line-height: 1.5;
    margin: 0;
  }

  .slot-subtopics-block {
    min-height: auto;
    gap: 6px;
  }

  .slot-tags-container {
    min-height: auto;
    gap: 6px;
  }

  .slot-tag {
    font-size: 0.68rem;
    padding: 4px 8px;
  }

  .slot-audience-row {
    min-height: auto;
    font-size: 0.78rem;
  }

  .slot-teaser-box {
    min-height: auto;
    font-size: 0.76rem;
    padding: 8px 10px;
  }

  .slot-action-area {
    margin-top: 4px;
    padding-top: 4px;
  }

  .slot-pending-btn {
    width: 100%;
    font-size: 0.72rem;
    padding: 10px 12px;
    min-height: 44px;
    letter-spacing: 0.06em;
  }

  /* Secondary Registration CTA Banner (Domain Closing Card) */
  .domain-closing-cta-card {
    flex-direction: column !important;
    align-items: flex-start !important;
    text-align: left !important;
    padding: 22px 18px !important;
    gap: 14px !important;
    margin-top: 28px !important;
    box-sizing: border-box !important;
    width: 100% !important;
    border: 1.5px solid var(--border-brass, #C89D42) !important;
    border-radius: 6px !important;
    background: rgba(26, 18, 12, 0.95) !important;
  }

  .domain-cta-content {
    width: 100% !important;
    max-width: 100% !important;
  }

  .domain-cta-content .bureau-tag {
    display: inline-block !important;
    max-width: 100% !important;
    white-space: normal !important;
    line-height: 1.35 !important;
    font-size: 0.70rem !important;
    padding: 4px 10px !important;
    margin-bottom: 12px !important;
    letter-spacing: 0.06em !important;
    box-sizing: border-box !important;
  }

  .domain-cta-title {
    font-size: clamp(1.25rem, 4.8vw, 1.65rem) !important;
    line-height: 1.25 !important;
    margin: 0 0 10px 0 !important;
    width: 100% !important;
    color: var(--paper-cream, #EFE6D2) !important;
  }

  .domain-cta-text {
    font-size: 0.88rem !important;
    line-height: 1.5 !important;
    margin: 0 0 14px 0 !important;
    width: 100% !important;
    color: var(--text-dim, #C8B9A6) !important;
  }

  .domain-cta-action {
    width: 100% !important;
    margin: 0 !important;
  }

  .domain-cta-action .btn-bureau-secondary {
    width: 100% !important;
    min-height: 44px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 12px 18px !important;
    font-size: 0.82rem !important;
    letter-spacing: 0.06em !important;
    box-sizing: border-box !important;
    text-align: center !important;
  }

  /* --- Section 04: The Shortlist --- */
  .results-dossier-chamber {
    padding: 14px 14px;
    border: 1.5px solid var(--border-brass, #C89D42);
    border-radius: 6px;
    background: rgba(22, 17, 13, 0.92);
  }

  .dossier-teletype-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(217, 169, 58, 0.25);
  }

  .teletype-title {
    font-size: 0.68rem;
  }

  .teletype-code {
    font-size: 0.62rem;
  }

  .results-status-banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 10px 12px;
    margin-bottom: 12px;
    border-radius: 4px;
  }

  .status-label {
    font-size: 0.62rem;
    margin-bottom: 2px;
  }

  .status-date-val,
  .status-state-val {
    font-size: 0.84rem;
  }

  .results-notice-body {
    padding: 12px 12px;
    font-size: 0.84rem;
    line-height: 1.45;
    margin-bottom: 12px;
    border-radius: 4px;
  }

  .notice-stamp-graphic {
    font-size: 0.70rem;
    padding: 2px 7px;
    margin-bottom: 8px;
    display: inline-block;
  }

  .roster-standby-message {
    font-size: 0.74rem;
    padding: 10px 12px;
    gap: 8px;
  }

  /* --- Section 05: Event Timeline --- */
  .tva-chronological-timeline {
    padding-left: 20px;
    position: relative;
  }

  .timeline-spine-track {
    left: 8px;
    width: 3px;
  }

  .timeline-milestones-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .timeline-milestone-item,
  .timeline-milestone-item.milestone-left,
  .timeline-milestone-item.milestone-right {
    display: block !important;
    width: 100% !important;
    left: auto !important;
    right: auto !important;
    text-align: left !important;
    padding-left: 18px !important;
    margin-left: 0 !important;
