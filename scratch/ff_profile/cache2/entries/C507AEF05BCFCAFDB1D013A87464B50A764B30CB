/* ==========================================================
   TVA TEMPORAL ENTRY ‚Äî 3D CINEMATIC INTRO STYLES
   Visual Identity: Marvel TVA Retro-Futuristic Industrial Gateway
   Primary Palette: Black, Deep Charcoal, Glowing Amber, Burnt Orange, Gold
========================================================== */

html.tva-intro-active,
body.tva-intro-active {
  overflow: hidden !important;
  height: 100vh !important;
}

.tva-temporal-intro {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999999;
  background: var(--bg-deep, #14110D);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  opacity: 1;
  transform: scale(1);
  filter: blur(0px);
  transition: opacity 0.95s cubic-bezier(0.22, 1, 0.36, 1),
              transform 0.95s cubic-bezier(0.22, 1, 0.36, 1),
              filter 0.95s cubic-bezier(0.22, 1, 0.36, 1);
  user-select: none;
  font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
  color: var(--paper, #EADFC4);
}

.tva-temporal-intro.fading-out {
  opacity: 0;
  transform: scale(1.035);
  filter: blur(4px);
  pointer-events: none;
}

.tva-temporal-intro.intro-complete {
  display: none !important;
}

/* 3D WebGL Canvas */
.tva-intro-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
}

/* Cinematic Letterbox Aspect Bars */
.tva-letterbox-bar {
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  height: clamp(24px, 4.5vh, 46px);
  background: var(--bg-deep, #14110D);
  z-index: 10;
  pointer-events: none;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.9);
}

.tva-letterbox-bar.bar-top {
  top: 0;
  border-bottom: 1px solid rgba(184, 146, 58, 0.25);
}

.tva-letterbox-bar.bar-bottom {
  bottom: 0;
  border-top: 1px solid rgba(184, 146, 58, 0.25);
}

/* Subtle CRT Scanlines & Optical Vignette */
.tva-intro-scanlines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 4;
  background: 
    radial-gradient(circle at 50% 50%, rgba(0,0,0,0) 45%, rgba(0,0,0,0.7) 100%),
    linear-gradient(rgba(18, 16, 12, 0) 50%, rgba(0, 0, 0, 0.35) 50%);
  background-size: 100% 100%, 100% 3px;
  opacity: 0.65;
}

/* Radial Vignette & Lens Flare Wash */
.tva-intro-flare-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 6;
  background: radial-gradient(circle at 50% 50%, rgba(255, 230, 170, 0.95) 0%, rgba(255, 140, 0, 0.7) 32%, rgba(232, 137, 43, 0.3) 60%, rgba(10, 6, 3, 0.9) 100%);
  opacity: 0;
  transition: opacity 0.15s ease-out;
}

.tva-intro-flare-overlay.active {
  opacity: 1;
}

/* ==========================================================
   HUD INTERFACE (TOP & BOTTOM STRIPS)
========================================================== */
.tva-intro-hud-top {
  position: relative;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: clamp(32px, 5.5vh, 52px) clamp(20px, 3.5vw, 42px) 0;
  box-sizing: border-box;
  width: 100%;
}

.tva-hud-telemetry {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.tva-hud-line-1 {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--crt-teal, #3FB5A0);
  text-transform: uppercase;
}

.tva-pulse-pip {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--crt-teal, #3FB5A0);
  box-shadow: 0 0 8px var(--crt-teal, #3FB5A0);
  animation: tvaPipPulse 1.2s ease-in-out infinite;
}

@keyframes tvaPipPulse {
  0%, 100% { opacity: 0.4; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.3); }
}

.tva-hud-line-2 {
  font-size: 0.65rem;
  color: var(--paper-dim, #7C735F);
  letter-spacing: 0.08em;
}

/* Skip & Sound Controls */
.tva-hud-controls {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tva-intro-audio-btn {
  background: var(--bg-surface, #1C1813);
  border: 1px solid rgba(184, 146, 58, 0.35);
  border-radius: 4px;
  color: var(--paper, #EADFC4);
  font-size: 0.85rem;
  padding: 6px 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
}

.tva-intro-audio-btn:hover {
  background: var(--bg-raised, #26201A);
  border-color: var(--crt-teal, #3FB5A0);
  transform: translateY(-1px);
}

.tva-intro-skip-btn {
  background: var(--bg-surface, #1C1813);
  border: 1px solid rgba(184, 146, 58, 0.45);
  border-radius: 4px;
  color: var(--paper, #EADFC4);
  padding: 7px 14px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.6), inset 0 0 10px rgba(232, 137, 43, 0.1);
  transition: all 0.2s ease;
}

.tva-intro-skip-btn:hover {
  background: rgba(232, 137, 43, 0.2);
  border-color: var(--paper, #EADFC4);
  color: #ffffff;
  box-shadow: 0 0 18px rgba(232, 137, 43, 0.45);
  transform: translateY(-1px);
}

.tva-intro-skip-btn .skip-key {
  font-size: 0.62rem;
  opacity: 0.65;
  background: rgba(255, 255, 255, 0.08);
  padding: 2px 5px;
  border-radius: 2px;
}

/* ==========================================================
   SCENE 4: GRAND CINEMATIC OVERCLOCK 2027 REVEAL
========================================================== */
.tva-intro-reveal {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
  pointer-events: none;
  opacity: 0;
  transform: scale(0.92);
  filter: blur(6px);
  transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
              filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  text-align: center;
  padding: 20px;
  box-sizing: border-box;
}

.tva-intro-reveal.reveal-active {
  opacity: 1;
  transform: scale(1);
  filter: blur(0px);
  pointer-events: auto;
}

/* Background Glowing TVA Emblem Watermark */
.reveal-tva-watermark {
  position: absolute;
  width: min(480px, 80vw);
  height: min(480px, 80vw);
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
  opacity: 0.35;
  background: radial-gradient(circle, rgba(232, 137, 43, 0.22) 0%, rgba(200, 80, 0, 0.08) 50%, transparent 72%);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: tvaWatermarkSlowSpin 40s linear infinite;
}

@keyframes tvaWatermarkSlowSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.reveal-watermark-svg {
  width: 100%;
  height: 100%;
  stroke: rgba(232, 137, 43, 0.3);
  stroke-dasharray: 4 6;
}

/* FCRIT & Organizing Clubs Presents Badge */
.reveal-presents-badge {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  background: var(--bg-surface, #1C1813);
  border: 1px solid rgba(184, 146, 58, 0.45);
  padding: 8px 18px;
  border-radius: 6px;
  margin-bottom: 20px;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.8), 0 0 16px rgba(232, 137, 43, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.reveal-emblems-group {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.reveal-club-emblem {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid rgba(184, 146, 58, 0.5);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  background: var(--bg-deep, #14110D);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.reveal-club-emblem:hover {
  transform: scale(1.15);
  border-color: var(--paper, #EADFC4);
}

.reveal-presents-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  line-height: 1.2;
}

.reveal-presents-text {
  font-family: 'IBM Plex Mono', monospace;
  font-size: clamp(0.85rem, 2.2vw, 1.05rem);
  font-weight: 900;
  letter-spacing: 0.22em;
  color: var(--paper, #EADFC4);
  text-transform: uppercase;
  text-shadow: 0 0 12px rgba(255, 170, 51, 0.45);
}

.reveal-presents-clubs {
  font-family: 'IBM Plex Mono', monospace;
  font-size: clamp(0.58rem, 1.4vw, 0.70rem);
  font-weight: 700;
  letter-spacing: 0.16em;
  color: rgba(255, 215, 153, 0.8);
  text-transform: uppercase;
  margin-top: 3px;
}

/* Master OVERCLOCK 2027 Title */
.reveal-title-wrap {
  margin: 0 0 10px;
}

.reveal-master-title {
  font-family: 'Barlow Condensed', 'Bebas Neue', sans-serif;
  font-size: clamp(3.4rem, 11vw, 7.5rem);
  font-weight: 900;
  letter-spacing: 0.04em;
  line-height: 0.95;
  margin: 0;
  text-transform: uppercase;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: clamp(4px, 1.2vw, 16px);
  filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.95));
}

.reveal-word-over {
  color: #ffffff;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.9), 0 0 15px rgba(255, 255, 255, 0.35);
  background: linear-gradient(180deg, #FFFFFF 20%, #D4CEBF 75%, #888070 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.reveal-word-clock {
  color: var(--tva-orange, #E8872B);
  text-shadow: 0 0 25px rgba(232, 135, 43, 0.85), 0 0 50px rgba(232, 135, 43, 0.45);
  background: linear-gradient(180deg, var(--tva-orange-hot, #FF9F45) 10%, var(--tva-orange, #E8872B) 70%, #8c421e 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  position: relative;
}

.reveal-year-tag {
  font-family: 'Special Elite', 'IBM Plex Mono', monospace;
  font-size: clamp(1.8rem, 5vw, 3.6rem);
  font-weight: 700;
  color: var(--paper, #EADFC4);
  letter-spacing: 0.12em;
  margin-left: 6px;
  text-shadow: 0 0 18px rgba(255, 170, 51, 0.6);
}

/* Tagline */
.reveal-tagline {
  font-family: 'Barlow Condensed', 'Inter', sans-serif;
  font-size: clamp(0.92rem, 2.4vw, 1.35rem);
  font-weight: 800;
  letter-spacing: 0.22em;
  color: var(--paper, #EADFC4);
  text-transform: uppercase;
  margin: 10px 0 8px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8), 0 0 16px rgba(255, 170, 51, 0.5);
}

/* Subtitle */
.reveal-subtitle {
  font-family: 'IBM Plex Mono', monospace;
  font-size: clamp(0.72rem, 1.8vw, 0.95rem);
  font-weight: 600;
  letter-spacing: 0.16em;
  color: var(--crt-teal, #3FB5A0);
  text-transform: uppercase;
  margin-bottom: 20px;
}

/* Hackathon Technology Track Strips */
.reveal-tracks-pill-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8px 14px;
  max-width: 780px;
  margin: 0 auto;
}

.reveal-track-pill {
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: rgba(239, 230, 210, 0.82);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(232, 137, 43, 0.3);
  padding: 3px 10px;
  border-radius: 3px;
  text-transform: uppercase;
}

/* ==========================================================
   HUD BOTTOM STATUS & PROGRESS TIMELINE
========================================================== */
.tva-intro-hud-bottom {
  position: relative;
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 0 clamp(20px, 3.5vw, 42px) clamp(30px, 5vh, 46px);
  box-sizing: border-box;
  width: 100%;
}

.tva-status-readout {
  font-size: clamp(0.68rem, 1.6vw, 0.78rem);
  letter-spacing: 0.14em;
  color: var(--paper, #EADFC4);
  text-shadow: 0 0 10px rgba(255, 170, 51, 0.5);
  text-transform: uppercase;
  font-weight: 600;
  min-height: 18px;
}

.tva-timeline-progress-track {
  width: min(580px, 92vw);
  height: 3px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.7);
}

.tva-timeline-progress-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--brass, #B8923A), var(--tva-orange, #E8872B), var(--paper, #EADFC4));
  box-shadow: 0 0 10px rgba(232, 135, 43, 0.45);
  border-radius: 2px;
  transition: width 0.1s linear;
}

.tva-timeline-phases-labels {
  display: flex;
  justify-content: space-between;
  width: min(580px, 92vw);
  font-size: 0.58rem;
  letter-spacing: 0.08em;
  color: rgba(217, 169, 58, 0.6);
  text-transform: uppercase;
}

.tva-phase-item.active {
  color: var(--paper, #EADFC4);
  font-weight: 700;
  text-shadow: 0 0 8px rgba(255, 170, 51, 0.6);
}

/* ==========================================================
   NAVBAR AUDIO ICON BUTTON
========================================================== */
.nav-audio-btn {
  background: var(--bg-surface, #1C1813);
  border: 1px solid rgba(184, 146, 58, 0.35);
  border-radius: 4px;
  color: var(--tva-orange, #E8872B);
  width: 36px;
  height: 36px;
  padding: 0;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: auto !important;
  position: relative;
  z-index: 600;
  user-select: none;
  flex-shrink: 0;
}

.nav-audio-btn:hover {
  background: var(--bg-raised, #26201A);
  border-color: var(--paper, #EADFC4);
  color: var(--paper, #EADFC4);
  box-shadow: 0 0 10px rgba(232, 137, 43, 0.38);
  transform: translateY(-1px);
}

.nav-audio-btn:active {
  transform: translateY(1px);
}

.nav-audio-btn:focus-visible {
  outline: 2px solid var(--tva-orange, #E8872B);
  outline-offset: 2px;
}

.nav-audio-btn.muted {
  background: var(--bg-surface, #1C1813);
  border-color: rgba(184, 146, 58, 0.25);
  color: var(--paper-dim, #7C735F);
}

.nav-audio-btn.muted:hover {
  background: var(--bg-raised, #26201A);
  border-color: var(--tva-orange, #E8872B);
  color: var(--tva-orange, #E8872B);
}

.nav-audio-btn .audio-toggle-svg {
  width: 17px;
  height: 17px;
  display: block;
}

/* ==========================================================
   REDUCED MOTION ACCESSIBILITY OVERRIDE
========================================================== */
@media (prefers-reduced-motion: reduce) {
  .tva-temporal-intro {
    display: none !important;
  }
}

/* Mobile Adjustments */
@media (max-width: 768px) {
  .tva-hud-line-2 {
    display: none;
  }
  .reveal-presents-badge {
    padding: 6px 12px;
    gap: 10px;
    margin-bottom: 14px;
  }
  .reveal-club-emblem {
    width: 22px;
    height: 22px;
  }
  .reveal-tracks-pill-strip {
    display: none;
  }
  .reveal-tagline {
    font-size: 0.85rem;
    letter-spacing: 0.14em;
  }
  .reveal-subtitle {
    font-size: 0.74rem;
    margin-bottom: 12px;
  }
  .tva-timeline-phases-labels {
    font-size: 0.52rem;
  }
}
