  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const hasScrollTarget = window.location.hash || urlParams.has('goto');

    const resetScrollToTop = () => {
      try {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      } catch (e) {
        window.scrollTo(0, 0);
      }
      document.documentElement.scrollTop = 0;
      if (document.body) document.body.scrollTop = 0;
    };

    if (!hasScrollTarget) {
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      resetScrollToTop();
      window.addEventListener('beforeunload', resetScrollToTop);
      window.addEventListener('pageshow', resetScrollToTop);
      window.addEventListener('DOMContentLoaded', resetScrollToTop);
      window.addEventListener('load', () => {
        resetScrollToTop();
        setTimeout(resetScrollToTop, 50);
      });
    } else {
      const targetId = (window.location.hash ? window.location.hash.slice(1) : urlParams.get('goto'));
      const scrollToTarget = () => {
        const el = document.getElementById(targetId);
        if (el) {
          el.scrollIntoView({ behavior: 'auto' });
        }
      };
      window.addEventListener('DOMContentLoaded', scrollToTarget);
      window.addEventListener('load', () => setTimeout(scrollToTarget, 60));
    }

    const searchParams = new URLSearchParams(window.location.search);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || searchParams.has('noboot') || searchParams.has('skipboot')) {
      document.documentElement.classList.add('skip-boot');
    }
    const onlySec = searchParams.get('only');
    if (onlySec) {
      document.addEventListener('DOMContentLoaded', () => {
        if (onlySec === 'domain-cta') {
          document.querySelectorAll('main > section').forEach(sec => {
            if (sec.id !== 'problems') sec.style.display = 'none';
          });
          const grid = document.querySelector('.domain-slots-grid');
          if (grid) grid.style.display = 'none';
        } else if (onlySec === 'clubs') {
          document.querySelectorAll('main > section').forEach(sec => {
            if (sec.id !== 'about') sec.style.display = 'none';
          });
          const dossier = document.querySelector('#about .case-file-dossier');
          if (dossier) dossier.style.display = 'none';
          const header = document.querySelector('#about .section-header-wrap');
          if (header) header.style.display = 'none';
          const stamp = document.querySelector('#about .section-rubber-stamp');
          if (stamp) stamp.style.display = 'none';
          if (searchParams.has('flip')) {
            document.querySelectorAll('.tva-club-card').forEach(c => {
              c.classList.add('is-flipped');
              c.setAttribute('aria-pressed', 'true');
            });
          }
        } else {
          document.querySelectorAll('main > section').forEach(sec => {
            if (sec.id !== onlySec) sec.style.display = 'none';
          });
        }
        const footer = document.querySelector('footer');
        if (footer && onlySec !== 'footer') footer.style.display = 'none';
      });
    }
