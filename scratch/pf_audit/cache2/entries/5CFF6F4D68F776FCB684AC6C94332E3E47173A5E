          draw: this.drawVibrationSawtooth.bind(this)
        },
        // Slot 6: Energy, Power & Sustainability (Ruby)
        {
          slot: 6,
          color: '#C64E5E',
          glowColor: 'rgba(198, 78, 94, 0.65)',
          beamColor: '#F6E1E4',
          baseFreq: 10.50,
          unit: 'GHz',
          idleTag: 'CARRIER ACTIVE // RUBY TRACE',
          hoverPrefix: 'GRID SYNCHRONIZED // 10.50 GHz Â· 50.02 Hz Â· 415 VAC',
          draw: this.drawThreePhaseAC.bind(this)
        }
      ];

      this.cards.forEach((card, index) => {
        const slotNum = parseInt(card.dataset.slot || (index + 1), 10);
        const config = DOMAIN_CONFIGS.find(c => c.slot === slotNum) || DOMAIN_CONFIGS[index % DOMAIN_CONFIGS.length];
        const screen = card.querySelector('.domain-screen-display');
        const container = card.querySelector('.screen-waveform-container');
        const channelTag = card.querySelector('.slot-channel-tag');

        if (!screen || !container) return;

        // Ensure reticle grid and CRT glow elements exist
        if (!screen.querySelector('.screen-reticle-grid')) {
          const reticle = document.createElement('div');
          reticle.className = 'screen-reticle-grid';
          reticle.setAttribute('aria-hidden', 'true');
          screen.insertBefore(reticle, screen.firstChild);
        }

        if (!screen.querySelector('.screen-crt-glow')) {
          const glow = document.createElement('div');
          glow.className = 'screen-crt-glow';
          glow.setAttribute('aria-hidden', 'true');
          screen.appendChild(glow);
        }

        // Hide fallback static SVG once canvas is active
        const fallbackSvg = container.querySelector('.waveform-svg');
        if (fallbackSvg) {
          fallbackSvg.classList.add('fallback-wave');
        }

        // Create or bind canvas
        let canvas = container.querySelector('.domain-scope-canvas');
        if (!canvas) {
          canvas = document.createElement('canvas');
          canvas.className = 'domain-scope-canvas';
          canvas.setAttribute('aria-hidden', 'true');
          container.appendChild(canvas);
        }

        const ctx = canvas.getContext('2d', { alpha: true });

        const scope = {
          slotNum,
          card,
          screen,
          container,
          canvas,
          ctx,
          config,
          channelTag,
          width: 0,
          height: 0,
          isHovered: false,
          hoverProgress: 0,
          probeX: 0.5,
          probeY: 0.5,
          jitterCounter: 0,
          ecgPhase: Math.random() * 10
        };

        this.bindScopeInteractions(scope);
        this.resizeScope(scope);
        this.scopes.push(scope);
      });
    }

    bindScopeInteractions(scope) {
      const updateProbe = (clientX, clientY) => {
        const rect = scope.screen.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          scope.probeX = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
          scope.probeY = Math.max(0, Math.min(1, (clientY - rect.top) / rect.height));
        }
      };

      scope.card.addEventListener('mouseenter', (e) => {
        scope.isHovered = true;
        updateProbe(e.clientX, e.clientY);
        scope.card.classList.add('scope-probed');
      });

      scope.card.addEventListener('mousemove', (e) => {
        updateProbe(e.clientX, e.clientY);
      });

      scope.card.addEventListener('mouseleave', () => {
        scope.isHovered = false;
        scope.card.classList.remove('scope-probed');
        if (scope.channelTag) {
          scope.channelTag.textContent = scope.config.idleTag;
          scope.channelTag.classList.remove('telemetry-active');
        }
      });

      // Mobile Touch Handling
      scope.card.addEventListener('touchstart', (e) => {
        if (e.touches && e.touches[0]) {
          scope.isHovered = true;
          updateProbe(e.touches[0].clientX, e.touches[0].clientY);
          scope.card.classList.add('scope-probed');
        }
      }, { passive: true });

      scope.card.addEventListener('touchmove', (e) => {
        if (e.touches && e.touches[0]) {
          updateProbe(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      scope.card.addEventListener('touchend', () => {
        setTimeout(() => {
          scope.isHovered = false;
          scope.card.classList.remove('scope-probed');
          if (scope.channelTag) {
            scope.channelTag.textContent = scope.config.idleTag;
            scope.channelTag.classList.remove('telemetry-active');
          }
        }, 1000);
      }, { passive: true });
    }

    resizeScope(scope) {
      const rect = scope.container.getBoundingClientRect();
      const cssWidth = Math.max(rect.width, 240);
      const cssHeight = Math.max(rect.height, 46);

      scope.width = cssWidth;
      scope.height = cssHeight;
      scope.canvas.width = Math.floor(cssWidth * this.dpr);
      scope.canvas.height = Math.floor(cssHeight * this.dpr);

      scope.ctx.setTransform(1, 0, 0, 1, 0, 0);
      scope.ctx.scale(this.dpr, this.dpr);
    }

    resizeAll() {
      this.dpr = Math.min(window.devicePixelRatio || 1, 2.0);
      this.scopes.forEach(scope => this.resizeScope(scope));
    }

    setupObserver() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            this.lastTime = performance.now();
            this.startLoop();
          } else {
            this.stopLoop();
          }
        });
      }, { threshold: 0.05 });

      observer.observe(this.gridContainer);
    }

    bindWindowEvents() {
      let resizeTimer = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => this.resizeAll(), 150);
      }, { passive: true });
    }

    startLoop() {
      if (this.rafId) return;
      const step = (now) => {
        const delta = Math.min((now - this.lastTime) / 1000, 0.1);
        this.lastTime = now;
        this.globalTime += delta;

        this.renderAll(delta, this.globalTime);

        if (this.isVisible) {
          this.rafId = requestAnimationFrame(step);
        } else {
          this.rafId = null;
        }
      };
      this.rafId = requestAnimationFrame(step);
    }

    stopLoop() {
      if (this.rafId) {
        cancelAnimationFrame(this.rafId);
        this.rafId = null;
      }
    }

    renderAll(delta, t) {
      this.scopes.forEach(scope => {
        // Smooth hover transition
        const targetHover = scope.isHovered ? 1.0 : 0.0;
        scope.hoverProgress += (targetHover - scope.hoverProgress) * Math.min(delta * 8.0, 1.0);

        // Update live fluctuating telemetry on hover
        if (scope.isHovered && scope.channelTag) {
          scope.jitterCounter += delta;
          if (scope.jitterCounter > 0.08) {
            scope.jitterCounter = 0;
            this.updateLiveTelemetry(scope);
          }
        }

        // Clear canvas
        const ctx = scope.ctx;
        const w = scope.width;
        const h = scope.height;
        ctx.clearRect(0, 0, w, h);

        // Draw Reticle Center Line on Canvas
        this.drawScopeGraticule(ctx, w, h);

        // Render domain-specific mathematical waveform
        scope.config.draw(scope, delta, t);
      });
    }

    updateLiveTelemetry(scope) {
      const tag = scope.channelTag;
      if (!tag) return;
      tag.classList.add('telemetry-active');

      const jitterFreq = (scope.config.baseFreq + (Math.random() * 0.08 - 0.04)).toFixed(2);
      const vpp = (3.2 + Math.random() * 0.35 + scope.hoverProgress * 0.5).toFixed(2);

      switch (scope.slotNum) {
        case 1:
          tag.textContent = `SIGNAL LOCKED // ${jitterFreq} MHz Â· ${vpp} Vpp Â· THD 1.1%`;
          break;
        case 2:
          const radarLock = (99.1 + Math.random() * 0.8).toFixed(1);
          tag.textContent = `TACTICAL ACQUIRED // ${jitterFreq} MHz Â· LOCK ${radarLock}%`;
          break;
        case 3:
          const bpm = Math.floor(74 + scope.hoverProgress * 18 + (Math.random() * 4 - 2));
          tag.textContent = `VITALS ACTIVE // ${bpm} BPM Â· SpO2 99% Â· ${jitterFreq} GHz`;
          break;
        case 4:
          const pwm = Math.floor(58 + scope.probeX * 28 + (Math.random() * 3));
          tag.textContent = `BUS SYNCED // ${jitterFreq} MHz Â· I2C 400kHz Â· PWM ${pwm}%`;
          break;
        case 5:
