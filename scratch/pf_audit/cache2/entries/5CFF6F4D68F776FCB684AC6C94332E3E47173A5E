/**
 * OVERCLOCK 2027 â€” CRT OSCILLOSCOPE & SIGNAL TELEMETRY ENGINE
 * FCRIT Ã— IEEE Student Branch
 *
 * Implements 6 mathematically authentic, domain-specific hardware waveforms
 * rendered onto vintage 1970s TVA-style phosphor CRT monitors with:
 *  - Tektronix-style graticule grid with center graduation tick marks
 *  - Phosphor persistence decay trails & electron beam luminous sweep heads
 *  - Domain 1 (Amber): Multi-Harmonic Synthesizer Waveform
 *  - Domain 2 (Cyan): Tactical Radar Chirp & Sonar Encrypted Pulse
 *  - Domain 3 (Emerald): Clinical Biometric ECG Heartbeat Monitor
 *  - Domain 4 (Violet): Digital Logic Analyzer & PWM Telemetry Bus
 *  - Domain 5 (Copper): Vibration Telemetry & Tachometer Sawtooth FFT
 *  - Domain 6 (Ruby): Resonant 3-Phase High-Voltage AC Power Wave
 *  - Interactive Signal Probe: Mouse/touch tracking modulates frequency and
 *    displays real-time fluctuating telemetry in the channel tag.
 *  - Performance-optimized: single RAF loop with IntersectionObserver sleep.
 */

(function () {
  'use strict';

  /* ==========================================================
     DOMAIN WAVE ACOUSTIC & HAPTIC VIBRATION SYNTHESIZER
     Generates authentic, mathematically tuned domain wave audio
     and physical haptic vibration for all 6 domain slots.
  ========================================================== */
  class DomainWaveAcousticEngine {
    constructor() {
      this.audioCtx = null;
      this.masterGain = null;
      this.activeVoice = null;
      this.activeSlot = null;
      this.pulseTimer = null;
      this.muted = false;
      this.bindUnlockGesture();
    }

    bindUnlockGesture() {
      const unlock = () => {
        this.ensureContext();
        window.removeEventListener('pointerdown', unlock);
        window.removeEventListener('keydown', unlock);
        window.removeEventListener('touchstart', unlock);
      };
      window.addEventListener('pointerdown', unlock, { passive: true });
      window.addEventListener('keydown', unlock, { passive: true });
      window.addEventListener('touchstart', unlock, { passive: true });
    }

    ensureContext() {
      if (!this.audioCtx) {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (AudioCtx) {
          this.audioCtx = new AudioCtx();
          this.masterGain = this.audioCtx.createGain();
          this.masterGain.gain.setValueAtTime(0.12, this.audioCtx.currentTime);
          this.masterGain.connect(this.audioCtx.destination);
        }
      }
      if (this.audioCtx && this.audioCtx.state === 'suspended') {
        this.audioCtx.resume();
      }
      return this.audioCtx;
    }

    triggerHaptic(slotNum) {
      if (typeof navigator === 'undefined' || !navigator.vibrate) return;
      try {
        const patterns = {
          1: [70],                      // Warm analog hum
          2: [35, 45, 35],              // Tactical sonar/radar chirp
          3: [50, 75, 40],              // Cardiac lub-dub pulse
          4: [15, 20, 15, 20, 25],      // High-speed digital packet chatter
          5: [120, 40, 80],             // Heavy rotating machinery
          6: [180]                      // High-voltage 50Hz AC buzz
        };
        const pat = patterns[slotNum] || [50];
        navigator.vibrate(pat);
      } catch (_) {}
    }

    startWaveVoice(slotNum, probeX = 0.5, probeY = 0.5) {
      if (this.muted || (window.overclockApp && !window.overclockApp.audioEnabled)) return;
      const ctx = this.ensureContext();
      if (!ctx) return;

      this.triggerHaptic(slotNum);

      if (this.activeSlot === slotNum && this.activeVoice) {
        this.modulateVoice(probeX, probeY);
        return;
      }

      this.stopWaveVoice();

      this.activeSlot = slotNum;
      const now = ctx.currentTime;

      switch (slotNum) {
        case 1:
          this.activeVoice = this.createHarmonicSynthVoice(ctx, now, probeX);
          break;
        case 2:
          this.activeVoice = this.createRadarSonarVoice(ctx, now, probeX);
          break;
        case 3:
          this.activeVoice = this.createECGHeartbeatVoice(ctx, now, probeX);
          break;
        case 4:
          this.activeVoice = this.createDigitalLogicVoice(ctx, now, probeX);
          break;
        case 5:
          this.activeVoice = this.createIndustrialVibrationVoice(ctx, now, probeX);
          break;
        case 6:
          this.activeVoice = this.createHighVoltageACVoice(ctx, now, probeX);
          break;
      }
    }

    modulateVoice(probeX, probeY) {
      if (this.activeVoice && typeof this.activeVoice.modulate === 'function') {
        this.activeVoice.modulate(probeX, probeY);
      }
    }

    triggerAcousticBurst(slotNum, probeX = 0.5) {
      this.startWaveVoice(slotNum, probeX, 0.5);
      setTimeout(() => {
        if (this.activeSlot === slotNum) {
          this.stopWaveVoice();
        }
      }, 1200);
    }

    stopWaveVoice() {
      if (this.pulseTimer) {
        clearInterval(this.pulseTimer);
        clearTimeout(this.pulseTimer);
        this.pulseTimer = null;
      }
      if (this.activeVoice) {
        try {
          this.activeVoice.stop();
        } catch (_) {}
        this.activeVoice = null;
      }
      this.activeSlot = null;
    }

    // 1. Slot 1: Multi-Harmonic Synthesizer (Amber)
    createHarmonicSynthVoice(ctx, now, probeX) {
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(0.001, now);
      voiceGain.gain.exponentialRampToValueAtTime(0.75, now + 0.08);

      const osc1 = ctx.createOscillator();
      osc1.type = 'triangle';
      osc1.frequency.setValueAtTime(196, now); // G3

      const osc2 = ctx.createOscillator();
      osc2.type = 'sawtooth';
      osc2.frequency.setValueAtTime(293.66, now); // D4
      osc2.detune.setValueAtTime(8, now);

      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.Q.setValueAtTime(3.8, now);
      filter.frequency.setValueAtTime(350 + probeX * 850, now);

      const lfo = ctx.createOscillator();
      const lfoGain = ctx.createGain();
      lfo.frequency.setValueAtTime(4.5, now);
      lfoGain.gain.setValueAtTime(3.5, now);
      lfo.connect(osc1.frequency);

      const oscMix = ctx.createGain();
      oscMix.gain.setValueAtTime(0.45, now);
      osc1.connect(filter);
      osc2.connect(oscMix);
      oscMix.connect(filter);

      filter.connect(voiceGain);
      voiceGain.connect(this.masterGain);

      osc1.start(now);
      osc2.start(now);
      lfo.start(now);

      return {
        modulate: (px) => {
          const targetFreq = 196 + px * 60;
          const targetCutoff = 350 + px * 1100;
          osc1.frequency.setTargetAtTime(targetFreq, ctx.currentTime, 0.04);
          osc2.frequency.setTargetAtTime(targetFreq * 1.5, ctx.currentTime, 0.04);
          filter.frequency.setTargetAtTime(targetCutoff, ctx.currentTime, 0.04);
        },
        stop: () => {
          const stopTime = ctx.currentTime;
          voiceGain.gain.cancelScheduledValues(stopTime);
          voiceGain.gain.setValueAtTime(voiceGain.gain.value, stopTime);
          voiceGain.gain.exponentialRampToValueAtTime(0.0001, stopTime + 0.14);
          setTimeout(() => {
            try {
              osc1.stop();
              osc2.stop();
              lfo.stop();
              voiceGain.disconnect();
            } catch (_) {}
          }, 160);
        }
      };
    }

    // 2. Slot 2: Tactical Radar & Sonar Ping (Cyan)
    createRadarSonarVoice(ctx, now, probeX) {
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(1.0, now);
      voiceGain.connect(this.masterGain);

      let currentProbeX = probeX;

      const triggerPing = () => {
        if (!this.activeVoice) return;
        const t = ctx.currentTime;

        // Sonar Ping (Resonant tone with slow decay)
        const pingOsc = ctx.createOscillator();
        const pingGain = ctx.createGain();
        pingOsc.type = 'sine';
        pingOsc.frequency.setValueAtTime(920 + currentProbeX * 280, t);
        pingOsc.frequency.exponentialRampToValueAtTime(800, t + 0.45);

        pingGain.gain.setValueAtTime(0.001, t);
        pingGain.gain.linearRampToValueAtTime(0.8, t + 0.015);
        pingGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.5);

        pingOsc.connect(pingGain);
        pingGain.connect(voiceGain);
        pingOsc.start(t);
        pingOsc.stop(t + 0.55);

        // Tactical Chirp Burst (Fast frequency radar sweep)
        const chirpOsc = ctx.createOscillator();
        const chirpGain = ctx.createGain();
        chirpOsc.type = 'sine';
        chirpOsc.frequency.setValueAtTime(1100, t);
        chirpOsc.frequency.exponentialRampToValueAtTime(2200, t + 0.065);

        chirpGain.gain.setValueAtTime(0.001, t);
        chirpGain.gain.linearRampToValueAtTime(0.35, t + 0.008);
        chirpGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.075);

        chirpOsc.connect(chirpGain);
        chirpGain.connect(voiceGain);
        chirpOsc.start(t);
        chirpOsc.stop(t + 0.08);

        this.triggerHaptic(2);
      };

      triggerPing();
      this.pulseTimer = setInterval(triggerPing, 700);

      return {
        modulate: (px) => {
          currentProbeX = px;
        },
        stop: () => {
          if (this.pulseTimer) clearInterval(this.pulseTimer);
          const stopTime = ctx.currentTime;
          voiceGain.gain.setTargetAtTime(0.0001, stopTime, 0.08);
          setTimeout(() => {
            try { voiceGain.disconnect(); } catch (_) {}
          }, 150);
        }
      };
    }

    // 3. Slot 3: Clinical Biometric ECG Heartbeat Monitor (Emerald)
    createECGHeartbeatVoice(ctx, now, probeX) {
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(1.0, now);
      voiceGain.connect(this.masterGain);

      const triggerECGCycle = () => {
        if (!this.activeVoice) return;
        const t = ctx.currentTime;

        // Cardiac Lub (Low damped tone)
        const lubOsc = ctx.createOscillator();
        const lubGain = ctx.createGain();
        lubOsc.type = 'sine';
        lubOsc.frequency.setValueAtTime(82, t);
        lubOsc.frequency.exponentialRampToValueAtTime(42, t + 0.07);

        lubGain.gain.setValueAtTime(0.001, t);
        lubGain.gain.linearRampToValueAtTime(0.72, t + 0.015);
        lubGain.gain.exponentialRampToValueAtTime(0.0001, t + 0.08);

        lubOsc.connect(lubGain);
        lubGain.connect(voiceGain);
        lubOsc.start(t);
        lubOsc.stop(t + 0.09);

        // Cardiac Dub (Second pulse)
        const dubTime = t + 0.11;
        const dubOsc = ctx.createOscillator();
        const dubGain = ctx.createGain();
        dubOsc.type = 'sine';
        dubOsc.frequency.setValueAtTime(68, dubTime);
        dubOsc.frequency.exponentialRampToValueAtTime(36, dubTime + 0.06);

        dubGain.gain.setValueAtTime(0.001, dubTime);
        dubGain.gain.linearRampToValueAtTime(0.6, dubTime + 0.012);
        dubGain.gain.exponentialRampToValueAtTime(0.0001, dubTime + 0.07);

        dubOsc.connect(dubGain);
        dubGain.connect(voiceGain);
        dubOsc.start(dubTime);
        dubOsc.stop(dubTime + 0.08);

        // Clinical Vitals Telemetry Monitor Blip (QRS)
        const beepTime = t + 0.22;
        const beepOsc = ctx.createOscillator();
        const beepGain = ctx.createGain();
        beepOsc.type = 'sine';
        beepOsc.frequency.setValueAtTime(987.77, beepTime);

        beepGain.gain.setValueAtTime(0.001, beepTime);
        beepGain.gain.linearRampToValueAtTime(0.4, beepTime + 0.008);
        beepGain.gain.exponentialRampToValueAtTime(0.0001, beepTime + 0.075);

        beepOsc.connect(beepGain);
        beepGain.connect(voiceGain);
        beepOsc.start(beepTime);
        beepOsc.stop(beepTime + 0.085);

        this.triggerHaptic(3);
      };

      triggerECGCycle();
      this.pulseTimer = setInterval(triggerECGCycle, 800);

      return {
        modulate: (px) => {
          const interval = 880 - px * 220;
          if (this.pulseTimer) clearInterval(this.pulseTimer);
          this.pulseTimer = setInterval(triggerECGCycle, interval);
        },
        stop: () => {
          if (this.pulseTimer) clearInterval(this.pulseTimer);
          const stopTime = ctx.currentTime;
          voiceGain.gain.setTargetAtTime(0.0001, stopTime, 0.08);
          setTimeout(() => {
            try { voiceGain.disconnect(); } catch (_) {}
          }, 150);
        }
      };
    }

    // 4. Slot 4: Digital Logic & PWM Telemetry Bus (Violet)
    createDigitalLogicVoice(ctx, now, probeX) {
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(1.0, now);
      voiceGain.connect(this.masterGain);

      let currentProbeX = probeX;

      const triggerDataPacket = () => {
        if (!this.activeVoice) return;
        const t = ctx.currentTime;
        const freqs = [587.33, 739.99, 880.00, 1174.66, 1479.98];
        const stepDur = 0.024;

        freqs.forEach((freq, idx) => {
          const stepTime = t + idx * stepDur;
          const osc = ctx.createOscillator();
          const g = ctx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(freq * (0.9 + currentProbeX * 0.3), stepTime);

          const filter = ctx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(1600, stepTime);

          g.gain.setValueAtTime(0.001, stepTime);
          g.gain.linearRampToValueAtTime(0.26, stepTime + 0.004);
          g.gain.exponentialRampToValueAtTime(0.0001, stepTime + stepDur - 0.002);

          osc.connect(filter);
          filter.connect(g);
          g.connect(voiceGain);

          osc.start(stepTime);
          osc.stop(stepTime + stepDur);
        });

        this.triggerHaptic(4);
      };

      triggerDataPacket();
      this.pulseTimer = setInterval(triggerDataPacket, 460);

      return {
        modulate: (px) => {
          currentProbeX = px;
        },
        stop: () => {
          if (this.pulseTimer) clearInterval(this.pulseTimer);
          const stopTime = ctx.currentTime;
          voiceGain.gain.setTargetAtTime(0.0001, stopTime, 0.06);
          setTimeout(() => {
            try { voiceGain.disconnect(); } catch (_) {}
          }, 120);
        }
      };
    }

    // 5. Slot 5: Industrial Automation Motor Vibration & Tachometer (Copper)
    createIndustrialVibrationVoice(ctx, now, probeX) {
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(0.001, now);
      voiceGain.gain.exponentialRampToValueAtTime(0.85, now + 0.09);

      const baseFreq = 75 + probeX * 55;
      const osc1 = ctx.createOscillator();
      osc1.type = 'sawtooth';
      osc1.frequency.setValueAtTime(baseFreq, now);

      const osc2 = ctx.createOscillator();
      osc2.type = 'sawtooth';
      osc2.frequency.setValueAtTime(baseFreq + 1.8, now);

      const subOsc = ctx.createOscillator();
      subOsc.type = 'sine';
      subOsc.frequency.setValueAtTime(baseFreq * 0.5, now);

      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.Q.setValueAtTime(3.6, now);
      filter.frequency.setValueAtTime(260 + probeX * 240, now);

      const mix1 = ctx.createGain();
      mix1.gain.setValueAtTime(0.42, now);
      const mix2 = ctx.createGain();
      mix2.gain.setValueAtTime(0.32, now);
      const mixSub = ctx.createGain();
      mixSub.gain.setValueAtTime(0.38, now);

      osc1.connect(mix1);
      osc2.connect(mix2);
      subOsc.connect(mixSub);

      mix1.connect(filter);
      mix2.connect(filter);
      mixSub.connect(filter);

      filter.connect(voiceGain);
      voiceGain.connect(this.masterGain);

      osc1.start(now);
      osc2.start(now);
      subOsc.start(now);

      return {
        modulate: (px) => {
          const f = 75 + px * 60;
          osc1.frequency.setTargetAtTime(f, ctx.currentTime, 0.05);
          osc2.frequency.setTargetAtTime(f + 1.8, ctx.currentTime, 0.05);
          subOsc.frequency.setTargetAtTime(f * 0.5, ctx.currentTime, 0.05);
          filter.frequency.setTargetAtTime(260 + px * 300, ctx.currentTime, 0.05);
        },
        stop: () => {
          const stopTime = ctx.currentTime;
          voiceGain.gain.cancelScheduledValues(stopTime);
          voiceGain.gain.setValueAtTime(voiceGain.gain.value, stopTime);
          voiceGain.gain.exponentialRampToValueAtTime(0.0001, stopTime + 0.16);
          setTimeout(() => {
            try {
              osc1.stop();
              osc2.stop();
              subOsc.stop();
              voiceGain.disconnect();
            } catch (_) {}
          }, 190);
        }
      };
    }

    // 6. Slot 6: High-Voltage 3-Phase AC Power Grid (Ruby)
    createHighVoltageACVoice(ctx, now, probeX) {
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(0.001, now);
      voiceGain.gain.exponentialRampToValueAtTime(0.85, now + 0.08);

      const osc50 = ctx.createOscillator();
      osc50.type = 'sine';
      osc50.frequency.setValueAtTime(50.0, now);

      const osc100 = ctx.createOscillator();
      osc100.type = 'sine';
      osc100.frequency.setValueAtTime(100.0, now);

      const osc150 = ctx.createOscillator();
      osc150.type = 'triangle';
      osc150.frequency.setValueAtTime(150.0, now);

      const gain50 = ctx.createGain();
      gain50.gain.setValueAtTime(0.65, now);
      const gain100 = ctx.createGain();
      gain100.gain.setValueAtTime(0.35, now);
      const gain150 = ctx.createGain();
      gain150.gain.setValueAtTime(0.2, now);

      osc50.connect(gain50);
      osc100.connect(gain100);
      osc150.connect(gain150);

      const gridMix = ctx.createGain();
      gain50.connect(gridMix);
      gain100.connect(gridMix);
      gain150.connect(gridMix);

      gridMix.connect(voiceGain);
      voiceGain.connect(this.masterGain);

      osc50.start(now);
      osc100.start(now);
      osc150.start(now);

      return {
        modulate: (px) => {
          const gridFreq = 50.0 + (px - 0.5) * 1.5;
          osc50.frequency.setTargetAtTime(gridFreq, ctx.currentTime, 0.08);
          osc100.frequency.setTargetAtTime(gridFreq * 2, ctx.currentTime, 0.08);
          osc150.frequency.setTargetAtTime(gridFreq * 3, ctx.currentTime, 0.08);
        },
        stop: () => {
          const stopTime = ctx.currentTime;
          voiceGain.gain.cancelScheduledValues(stopTime);
          voiceGain.gain.setValueAtTime(voiceGain.gain.value, stopTime);
          voiceGain.gain.exponentialRampToValueAtTime(0.0001, stopTime + 0.16);
          setTimeout(() => {
            try {
              osc50.stop();
              osc100.stop();
              osc150.stop();
              voiceGain.disconnect();
            } catch (_) {}
          }, 190);
        }
      };
    }
  }

  class DomainOscilloscopeEngine {
    constructor() {
      this.gridContainer = document.querySelector('.domain-slots-grid');
      if (!this.gridContainer) return;

      this.cards = Array.from(document.querySelectorAll('.domain-slot-card'));
      if (this.cards.length === 0) return;

      this.isVisible = false;
      this.rafId = null;
      this.lastTime = performance.now();
      this.globalTime = 0;
      this.dpr = Math.min(window.devicePixelRatio || 1, 2.0);
      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.acousticEngine = new DomainWaveAcousticEngine();
      this.scopes = [];
      this.initScopes();
      this.setupObserver();
      this.bindWindowEvents();
