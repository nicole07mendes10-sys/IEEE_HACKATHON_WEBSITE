          break;
        default:
          tag.textContent = scope.config.hoverPrefix;
      }
    }

    drawScopeGraticule(ctx, w, h) {
      ctx.save();
      const midY = h * 0.5;

      // Center horizontal axis
      ctx.beginPath();
      ctx.setLineDash([2, 4]);
      ctx.strokeStyle = 'rgba(184, 146, 58, 0.2)';
      ctx.lineWidth = 1;
      ctx.moveTo(0, midY);
      ctx.lineTo(w, midY);
      ctx.stroke();

      // Tick marks on center horizontal axis
      ctx.setLineDash([]);
      ctx.strokeStyle = 'rgba(184, 146, 58, 0.3)';
      const step = w / 10;
      for (let i = 1; i < 10; i++) {
        const x = i * step;
        ctx.beginPath();
        ctx.moveTo(x, midY - 3);
        ctx.lineTo(x, midY + 3);
        ctx.stroke();
      }

      ctx.restore();
    }

    /**
