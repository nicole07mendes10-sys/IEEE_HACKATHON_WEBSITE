    drawHarmonicSynthesizer(scope, delta, t) {
      const { ctx, width: w, height: h, config, hoverProgress, probeX } = scope;
      const midY = h * 0.5;
      const speed = (this.prefersReducedMotion ? 1.0 : 3.5) + hoverProgress * 3.0;
      const fHarmonic = 3.0 + hoverProgress * (probeX * 3.0 + 1.0);

      const amp1 = h * 0.32;
      const amp2 = h * (0.12 + hoverProgress * 0.08);
      const amp3 = h * (0.05 + hoverProgress * 0.04);

      // Phosphor Glow Layer
      ctx.save();
      ctx.beginPath();
      ctx.strokeStyle = config.glowColor;
      ctx.lineWidth = 3.5 + hoverProgress * 1.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.shadowColor = config.color;
      ctx.shadowBlur = 12 + hoverProgress * 8;

      const points = [];
      const steps = Math.min(Math.floor(w / 2), 140);
      for (let i = 0; i <= steps; i++) {
        const u = i / steps;
        const x = u * w;
        const y = midY +
          Math.sin(u * Math.PI * 4 - t * speed) * amp1 +
          Math.sin(u * Math.PI * fHarmonic * 2 - t * speed * 1.6 + 0.8) * amp2 +
          Math.sin(u * Math.PI * 12 + t * speed * 0.8) * amp3;
        points.push({ x, y });
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Sharp Core Electron Beam
      ctx.beginPath();
      ctx.strokeStyle = config.beamColor;
      ctx.lineWidth = 1.6;
      ctx.shadowBlur = 0;
      points.forEach((pt, i) => {
        if (i === 0) ctx.moveTo(pt.x, pt.y);
        else ctx.lineTo(pt.x, pt.y);
      });
      ctx.stroke();

      // Leading Electron Sweep Head
      const sweepU = (t * 0.35 * speed) % 1.0;
      const sweepIdx = Math.floor(sweepU * (points.length - 1));
      const head = points[sweepIdx] || points[0];

      const grad = ctx.createRadialGradient(head.x, head.y, 0, head.x, head.y, 16);
      grad.addColorStop(0, '#FFFFFF');
      grad.addColorStop(0.25, config.color);
      grad.addColorStop(1, 'transparent');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(head.x, head.y, 14, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

