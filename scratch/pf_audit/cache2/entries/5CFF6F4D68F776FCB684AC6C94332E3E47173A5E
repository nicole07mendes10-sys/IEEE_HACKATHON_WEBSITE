    drawScopeGraticule(ctx, w, h) {
      ctx.save();
      const midY = h * 0.5;

      // Center horizontal axis
      ctx.beginPath();
      ctx.setLineDash([2, 4]);
      ctx.strokeStyle = 'rgba(184, 146, 58, 0.2)';
      ctx.lineWidth = 1;
      ctx.moveTo(0, midY);
      ctx.lineTo(w, midY);
      ctx.stroke();

      // Tick marks on center horizontal axis
      ctx.setLineDash([]);
      ctx.strokeStyle = 'rgba(184, 146, 58, 0.3)';
      const step = w / 10;
