/**
 * OVERCLOCK 2027 ‚Äî APPLICATION LOGIC & BUREAU INTERACTIVITY
 * FCRIT √ó IEEE Student Branch
 * Features:
 * 1. Web Audio API sound synthesis (relay clicks, stamp thunk, flip-clock clicks).
 * 2. Session-cached fast boot sequence (max 2.5s).
 * 3. Scroll-linked Prime Timeline pulse runner & section rubber stamper.
 * 4. Hero clock animator with 60s overclock spin.
 * 5. 555 Timer "Sync the Clock" interactive mini puzzle solver.
 * 6. Dynamic Sponsors ("Authorized Partners") tier generator & card stamper.
 * 7. FAQ Manila folder typewriter expansion.
 * 8. Real-time live clock in Corner HUD.
 * 9. "Open a Case File" modal handler.
 */

/* ==========================================================
   BUREAU SPATIAL 3D SCROLL CONTROLLER
   Continuous, Bi-Directional, Scrub-Linked 3D Spatial System
========================================================== */
class BureauSpatialScrollController {
  constructor(app) {
    this.app = app;
    this.targetScrollY = 0;
    this.smoothScrollY = 0;
    this.lerpFactor = 0.18;
    this.isTicking = false;
    this.isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    this.isMobile = window.innerWidth <= 768;
    this.pointerTilts = new WeakMap();

    this.cacheElements();
    this.setupListeners();
    this.startLoop();
  }

  cacheElements() {
    // Section 02: Briefing Dossier
    this.aboutSec = document.getElementById('about');
    this.dossierGrid = this.aboutSec ? this.aboutSec.querySelector('.case-notes-grid') : null;
    this.dossierCards = this.aboutSec ? Array.from(this.aboutSec.querySelectorAll('.case-note-card')) : [];

    // Section 03: Problem Statements Six Domains (Balanced 3x2 Grid)
    this.problemsSec = document.getElementById('problems');
    this.domainGrid = this.problemsSec ? this.problemsSec.querySelector('.domain-slots-grid') : null;
    this.domainCards = this.problemsSec ? Array.from(this.problemsSec.querySelectorAll('.domain-slot-card')) : [];

    // Section 04: Results Shortlist Teletype
    this.resultsSec = document.getElementById('results');
    this.resultsChamber = this.resultsSec ? this.resultsSec.querySelector('.results-dossier-chamber') : null;

    // Section 05: Timeline Reel Deck
    this.timelineSec = document.getElementById('timeline');
    this.timelineDeck = this.timelineSec ? this.timelineSec.querySelector('.timeline-reel-deck') : null;
    this.spoolGraphics = this.timelineSec ? Array.from(this.timelineSec.querySelectorAll('.spool-graphic')) : [];
    this.filmFrames = this.timelineSec ? Array.from(this.timelineSec.querySelectorAll('.film-frame-card')) : [];
    this.timelineHeading = this.timelineSec ? this.timelineSec.querySelector('.section-main-heading') : null;

    // Section 06: Registration Terminal
    this.registrationSec = document.getElementById('registration');
    this.regTerminal = this.registrationSec ? this.registrationSec.querySelector('.registration-terminal-card') : null;

    // Section 07: Accommodation
    this.accommodationSec = document.getElementById('accommodation');
    this.quartersCards = this.accommodationSec ? Array.from(this.accommodationSec.querySelectorAll('.quarters-stat-card')) : [];

    // Section 08: Judging & Recognition
    this.judgingSec = document.getElementById('judging');
    this.pillarCards = this.judgingSec ? Array.from(this.judgingSec.querySelectorAll('.pillar-card')) : [];

    // Section 09: Sponsors Pinboard
    this.sponsorsSec = document.getElementById('sponsors');
    this.sponsorsPinboard = this.sponsorsSec ? this.sponsorsSec.querySelector('.sponsors-pinboard-deck') : null;
    this.cacheSponsorCards();

    // Section 10: FAQ Manila Folders
    this.faqSec = document.getElementById('faq');
    this.faqAccordion = this.faqSec ? this.faqSec.querySelector('.case-files-accordion') : null;
    this.faqFolders = this.faqSec ? Array.from(this.faqSec.querySelectorAll('.case-folder-unit')) : [];

    // Section 11: Contact Dossier
    this.contactSec = document.getElementById('contact');
    this.contactCards = this.contactSec ? Array.from(this.contactSec.querySelectorAll('.contact-dossier-card')) : [];

    // Section 12: Footer Filing Drawer
    this.footerSec = document.querySelector('.filing-cabinet-footer');
    this.filingDrawer = this.footerSec ? this.footerSec.querySelector('.filing-drawer-box') : null;
    this.completionCard = this.footerSec ? this.footerSec.querySelector('.center-timeline-complete-card') : null;
  }

  cacheSponsorCards() {
    if (this.sponsorsSec) {
      this.sponsorCards = Array.from(this.sponsorsSec.querySelectorAll('.auth-clearance-card'));
    } else {
      this.sponsorCards = [];
    }
  }

  setupListeners() {
    window.addEventListener('scroll', () => this.onScroll(), { passive: true });
    window.addEventListener('resize', () => {
      this.isMobile = window.innerWidth <= 768;
      this.targetScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
      this.render();
    }, { passive: true });

    window.addEventListener('orientationchange', () => {
      setTimeout(() => {
        this.isMobile = window.innerWidth <= 768;
        this.targetScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
        this.render();
      }, 100);
    }, { passive: true });

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionQuery.addEventListener('change', (e) => {
      this.isReducedMotion = e.matches;
      this.render();
    });
  }

  onScroll() {
    this.targetScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
    if (!this.isTicking) {
      this.startLoop();
    }
  }

  startLoop() {
    this.isTicking = true;
    requestAnimationFrame(() => this.render());
  }

  render() {
    if (this.isReducedMotion || this.isMobile) {
      this.resetAllTransforms();
      this.isTicking = false;
      return;
    }

    const diff = this.targetScrollY - this.smoothScrollY;
    if (Math.abs(diff) < 0.05) {
      this.smoothScrollY = this.targetScrollY;
    } else {
      this.smoothScrollY += diff * this.lerpFactor;
    }

    this.updateBriefingSection();
    this.updateProblemsSection();
    this.updateResultsSection();
    this.updateTimelineSection();
    this.updateRegistrationSection();
    this.updateAccommodationSection();
    this.updateJudgingSection();
    this.updateSponsorsSection();
    this.updateFAQSection();
    this.updateContactSection();
    this.updateFooterSection();

    if (Math.abs(this.targetScrollY - this.smoothScrollY) >= 0.05) {
      requestAnimationFrame(() => this.render());
    } else {
      this.isTicking = false;
    }
  }

  getSectionProgress(el) {
    if (!el) return -1;
    const rect = el.getBoundingClientRect();
    const vh = window.innerHeight;
    const total = vh + rect.height;
    if (total <= 0) return 0;
    return (vh - rect.top) / total;
  }

  setPointerTilt(card, tiltX, tiltY) {
    this.pointerTilts.set(card, { tiltX, tiltY });
    if (!this.isTicking) {
      this.startLoop();
    }
  }

  clearPointerTilt(card) {
    this.pointerTilts.delete(card);
    if (!this.isTicking) {
      this.startLoop();
    }
  }

  getPointerTilt(card) {
    return this.pointerTilts.get(card) || { tiltX: 0, tiltY: 0 };
  }

  /* --------------------------------------------------------
     1. BRIEFING / ABOUT SECTION (4 DOSSIER CARDS)
  -------------------------------------------------------- */
  updateBriefingSection() {
    if (!this.aboutSec || this.dossierCards.length === 0) return;
    const p = this.getSectionProgress(this.aboutSec);
    if (p < -0.1 || p > 1.1) return;

    const rotXInits = [5.5, 6.5, 6.5, 5.5];
    const rotYInits = [-4.5, -2.0, 2.0, 4.5];
    const rotZInits = [-1.2, -0.5, 0.5, 1.2];

    this.dossierCards.forEach((card, i) => {
      const c_i = 0.36 + i * 0.08;
      const d = p - c_i;
      const f = Math.max(0, 1 - Math.abs(d) / 0.12);
      const f_smooth = f * f * (3 - 2 * f);

      const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
      const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

      const baseZ = -55 * (1 - enterT) - 35 * exitT;
      let tz = baseZ + (28 - baseZ) * f_smooth;

      let rx = (rotXInits[i] * (1 - enterT) - 3.0 * exitT) * (1 - f_smooth);
      let ry = (rotYInits[i] * (1 - enterT) + (rotYInits[i] * 0.4) * exitT) * (1 - f_smooth);
      let rz = rotZInits[i] * (1 - f_smooth);
      let scale = 0.98 + 0.05 * f_smooth;
      let tx = (i - 1.5) * 5 * (1 - f_smooth * 0.5);

      // Blend mouse pointer tilt if hovered
      const pt = this.getPointerTilt(card);
      rx += pt.tiltX;
      ry += pt.tiltY;

      if (this.isMobile) {
        rx *= 0.35;
        ry *= 0.35;
        rz = 0;
        tx = 0;
        tz = Math.max(-18, Math.min(14, tz));
        scale = Math.min(scale, 1.018);
      }

      card.style.transform = `perspective(1000px) translate3d(${tx.toFixed(1)}px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) rotateZ(${rz.toFixed(2)}deg) scale(${scale.toFixed(3)})`;

      if (f_smooth > 0.04) {
        const glow = (f_smooth * 0.65).toFixed(2);
        const sy = (8 + f_smooth * 12).toFixed(1);
        const sb = (18 + f_smooth * 16).toFixed(1);
        card.style.boxShadow = `0 ${sy}px ${sb}px rgba(0, 0, 0, 0.45), 0 0 ${(f_smooth * 18).toFixed(1)}px rgba(184, 146, 58, ${glow}), inset 0 0 ${(f_smooth * 6).toFixed(1)}px rgba(184, 146, 58, 0.2)`;
        card.style.outline = `1.5px solid rgba(184, 146, 58, ${(f_smooth * 0.7).toFixed(2)})`;
      } else {
        card.style.boxShadow = '';
        card.style.outline = '';
      }

      const clip = card.querySelector('.paperclip-graphic');
      if (clip) {
        clip.style.transform = `translateY(${(-f_smooth * 4).toFixed(1)}px) rotate(${(f_smooth * 3).toFixed(1)}deg)`;
      }
    });
  }

  /* --------------------------------------------------------
     2. PROBLEM STATEMENTS (SIX DOMAIN SLOTS ‚Äî BALANCED 3x2 GRID)
  -------------------------------------------------------- */
  updateProblemsSection() {
    if (!this.problemsSec) return;
    const p = this.getSectionProgress(this.problemsSec);
    if (p < -0.1 || p > 1.1) return;

    // Preserve uniform horizontal alignment: clear any residual scroll transforms on individual cards,
    // while seamlessly supporting pointer-tilt on hover.
    this.domainCards.forEach((card) => {
      const pt = this.getPointerTilt(card);
      if (pt.tiltX || pt.tiltY) {
        let rx = pt.tiltX;
        let ry = pt.tiltY;
        if (this.isMobile) {
          rx *= 0.35;
          ry *= 0.35;
        }
        card.style.transform = `perspective(1000px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
      } else if (card.style.transform) {
        card.style.transform = '';
      }
    });

    // Animate the entire domain grid chamber harmoniously without distorting row alignments
    if (this.domainGrid) {
      const enterT = Math.min(1, Math.max(0, (p - 0.12) / 0.32));
      const exitT = Math.min(1, Math.max(0, (p - 0.70) / 0.30));
      let rx = (2.0 * (1 - enterT) - 1.2 * exitT);
      let tz = -20 * (1 - enterT) + 10 * enterT * (1 - exitT);

      if (this.isMobile) {
        rx *= 0.35;
        tz = Math.max(-8, tz);
      }
      this.domainGrid.style.transform = `perspective(1000px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg)`;
    }
  }

  /* --------------------------------------------------------
     3. RESULTS (TELETYPE SHORTLIST CHAMBER)
  -------------------------------------------------------- */
  updateResultsSection() {
    if (!this.resultsSec || !this.resultsChamber) return;
    const p = this.getSectionProgress(this.resultsSec);
    if (p < -0.1 || p > 1.1) return;

    const enterT = Math.min(1, Math.max(0, (p - 0.15) / 0.35));
    const exitT = Math.min(1, Math.max(0, (p - 0.60) / 0.35));
    let rx = (3.5 * (1 - enterT) - 2.0 * exitT);
    let tz = -30 * (1 - enterT) + 18 * enterT * (1 - exitT);

    if (this.isMobile) {
      rx *= 0.35;
      tz = Math.max(-12, tz);
    }
    this.resultsChamber.style.transform = `perspective(1000px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg)`;
  }

  /* --------------------------------------------------------
     4. TIMELINE SECTION (REEL DECK & 5 MILESTONES)
  -------------------------------------------------------- */
  updateTimelineSection() {
    if (!this.timelineSec) return;
    const p = this.getSectionProgress(this.timelineSec);
    if (p < -0.1 || p > 1.1) return;

    // Rotate magnetic spools proportional to scroll progress
    const spoolRot = (p * 720).toFixed(1);
    this.spoolGraphics.forEach(spool => {
      spool.style.transform = `rotate(${spoolRot}deg)`;
    });

    // Milestone film frames (5 milestones)
    this.filmFrames.forEach((frame, i) => {
      const c_i = 0.28 + i * 0.08;
      const d = p - c_i;
      const f = Math.max(0, 1 - Math.abs(d) / 0.12);
      const f_smooth = f * f * (3 - 2 * f);

      const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
      const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

      const isFinal = i === 4; // Milestone 05: Final Problem Statement
      const targetZ = isFinal ? 32 : 22;
      const baseZ = -40 * (1 - enterT) - 20 * exitT;
      let tz = baseZ + (targetZ - baseZ) * f_smooth;

      let rx = (3.5 * (1 - enterT) - 2.0 * exitT) * (1 - f_smooth);
      let ry = ((i - 2.0) * 2.5 * (1 - enterT)) * (1 - f_smooth);
      let scale = 0.98 + 0.04 * f_smooth;

      if (this.isMobile) {
        rx *= 0.35;
        ry *= 0.35;
        tz = Math.max(-15, Math.min(12, tz));
        scale = Math.min(scale, 1.018);
      }

      frame.style.transform = `perspective(1000px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${scale.toFixed(3)})`;

      if (isFinal && f_smooth > 0.05) {
        frame.style.boxShadow = `0 0 ${(16 + f_smooth * 20).toFixed(1)}px rgba(184, 146, 58, 0.35)`;
      } else if (f_smooth > 0.08) {
        frame.style.boxShadow = `0 8px 20px rgba(0, 0, 0, 0.5), 0 0 ${(f_smooth * 14).toFixed(1)}px rgba(184, 146, 58, 0.25)`;
      } else {
        frame.style.boxShadow = '';
      }
    });
  }

  /* --------------------------------------------------------
     5. REGISTRATION (TERMINAL CARD)
  -------------------------------------------------------- */
  updateRegistrationSection() {
    if (!this.registrationSec || !this.regTerminal) return;
    const p = this.getSectionProgress(this.registrationSec);
    if (p < -0.1 || p > 1.1) return;

    const enterT = Math.min(1, Math.max(0, (p - 0.15) / 0.35));
    const exitT = Math.min(1, Math.max(0, (p - 0.65) / 0.35));
    let rx = 3.5 * (1 - enterT) - 2.0 * exitT;
    let tz = -30 * (1 - enterT) + 20 * enterT * (1 - exitT);

    if (this.isMobile) {
      rx *= 0.35;
      tz = Math.max(-12, tz);
    }
    this.regTerminal.style.transform = `perspective(1000px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg)`;
  }

  /* --------------------------------------------------------
     6. ACCOMMODATION (QUARTERS STAT CARDS)
  -------------------------------------------------------- */
  updateAccommodationSection() {
    if (!this.accommodationSec || this.quartersCards.length === 0) return;
    const p = this.getSectionProgress(this.accommodationSec);
    if (p < -0.1 || p > 1.1) return;

    this.quartersCards.forEach((card, i) => {
      const c_i = 0.28 + i * 0.08;
      const d = p - c_i;
      const f = Math.max(0, 1 - Math.abs(d) / 0.12);
      const f_smooth = f * f * (3 - 2 * f);

      const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
      const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

      const baseZ = -30 * (1 - enterT) - 15 * exitT;
      let tz = baseZ + (20 - baseZ) * f_smooth;
      let scale = 0.98 + 0.03 * f_smooth;

      if (this.isMobile) {
        tz = Math.max(-12, Math.min(10, tz));
        scale = 1;
      }

      card.style.transform = `perspective(800px) translate3d(0px, 0px, ${tz.toFixed(1)}px) scale(${scale.toFixed(3)})`;
    });
  }

  /* --------------------------------------------------------
     7. JUDGING & RECOGNITION (EVALUATION PILLARS)
  -------------------------------------------------------- */
  updateJudgingSection() {
    if (!this.judgingSec || this.pillarCards.length === 0) return;
    const p = this.getSectionProgress(this.judgingSec);
    if (p < -0.1 || p > 1.1) return;

    this.pillarCards.forEach((card, i) => {
      const c_i = 0.28 + i * 0.08;
      const d = p - c_i;
      const f = Math.max(0, 1 - Math.abs(d) / 0.12);
      const f_smooth = f * f * (3 - 2 * f);

      const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
      const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

      const baseZ = -30 * (1 - enterT) - 15 * exitT;
      let tz = baseZ + (22 - baseZ) * f_smooth;
      let scale = 0.98 + 0.035 * f_smooth;

      if (this.isMobile) {
        tz = Math.max(-12, Math.min(10, tz));
        scale = 1;
      }

      card.style.transform = `perspective(800px) translate3d(0px, 0px, ${tz.toFixed(1)}px) scale(${scale.toFixed(3)})`;
    });
  }

  /* --------------------------------------------------------
     8. SPONSORS (PINBOARD CLEARANCE CARDS)
  -------------------------------------------------------- */
  updateSponsorsSection() {
    if (!this.sponsorsSec) return;
    const p = this.getSectionProgress(this.sponsorsSec);
    if (p < -0.1 || p > 1.1) return;

    if (this.sponsorCards && this.sponsorCards.length > 0) {
      this.sponsorCards.forEach((card, i) => {
        const c_i = 0.32 + (i % 6) * 0.07;
        const d = p - c_i;
        const f = Math.max(0, 1 - Math.abs(d) / 0.12);
        const f_smooth = f * f * (3 - 2 * f);

        const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
        const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

        const baseZ = -35 * (1 - enterT) - 15 * exitT;
        let tz = baseZ + (22 - baseZ) * f_smooth;

        const organicTilts = [0, -1.2, 1.2, -1.0, 0.4, 1.2];
        const tiltInit = organicTilts[i % organicTilts.length];
        let rz = tiltInit * (1 - f_smooth);
        let rx = (2.5 * (1 - enterT)) * (1 - f_smooth);
        let scale = 0.98 + 0.03 * f_smooth;

        if (this.isMobile) {
          rx *= 0.35;
          rz = 0;
          tz = Math.max(-15, Math.min(12, tz));
          scale = Math.min(scale, 1.015);
        }

        card.style.transform = `perspective(1000px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg) rotateZ(${rz.toFixed(2)}deg) scale(${scale.toFixed(3)})`;

        if (f_smooth > 0.06) {
          card.style.boxShadow = `0 12px 28px rgba(0, 0, 0, 0.5), 0 0 ${(f_smooth * 18).toFixed(1)}px rgba(184, 146, 58, ${(f_smooth * 0.45).toFixed(2)})`;
        } else {
          card.style.boxShadow = '';
        }
      });
    }
  }

  /* --------------------------------------------------------
     9. FAQ (MANILA CASE FOLDERS)
  -------------------------------------------------------- */
  updateFAQSection() {
    if (!this.faqSec || this.faqFolders.length === 0) return;
    const p = this.getSectionProgress(this.faqSec);
    if (p < -0.1 || p > 1.1) return;

    this.faqFolders.forEach((folder, i) => {
      const c_i = 0.32 + i * 0.08;
      const d = p - c_i;
      const f = Math.max(0, 1 - Math.abs(d) / 0.12);
      const f_smooth = f * f * (3 - 2 * f);

      const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
      const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

      const baseZ = -30 * (1 - enterT) - 12 * exitT;
      let tz = baseZ + (18 - baseZ) * f_smooth;
      let rx = (3.5 * (1 - enterT) - 2.0 * exitT) * (1 - f_smooth);
      let scale = 0.99 + 0.02 * f_smooth;

      if (this.isMobile) {
        rx *= 0.35;
        tz = Math.max(-12, Math.min(10, tz));
        scale = 1.0;
      }

      folder.style.transform = `perspective(800px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg) scale(${scale.toFixed(3)})`;

      if (f_smooth > 0.1) {
        folder.style.boxShadow = `0 6px 20px rgba(0, 0, 0, 0.4), 0 0 ${(f_smooth * 16).toFixed(1)}px rgba(184, 146, 58, ${(f_smooth * 0.35).toFixed(2)})`;
      } else if (!folder.classList.contains('open')) {
        folder.style.boxShadow = '';
      }
    });
  }

  /* --------------------------------------------------------
     10. CONTACT (DOSSIER CARDS)
  -------------------------------------------------------- */
  updateContactSection() {
    if (!this.contactSec || this.contactCards.length === 0) return;
    const p = this.getSectionProgress(this.contactSec);
    if (p < -0.1 || p > 1.1) return;

    this.contactCards.forEach((card, i) => {
      const c_i = 0.30 + i * 0.09;
      const d = p - c_i;
      const f = Math.max(0, 1 - Math.abs(d) / 0.12);
      const f_smooth = f * f * (3 - 2 * f);

      const enterT = Math.min(1, Math.max(0, (p - (c_i - 0.20)) / 0.20));
      const exitT = Math.min(1, Math.max(0, (p - c_i) / 0.25));

      const baseZ = -28 * (1 - enterT) - 12 * exitT;
      let tz = baseZ + (18 - baseZ) * f_smooth;
      let scale = 0.99 + 0.025 * f_smooth;

      if (this.isMobile) {
        tz = Math.max(-10, Math.min(8, tz));
        scale = 1.0;
      }

      card.style.transform = `perspective(800px) translate3d(0px, 0px, ${tz.toFixed(1)}px) scale(${scale.toFixed(3)})`;
    });
  }

  /* --------------------------------------------------------
     11. FOOTER (FILING CABINET DRAWER & COMPLETION CARD)
  -------------------------------------------------------- */
  updateFooterSection() {
    if (!this.footerSec) return;
    const p = this.getSectionProgress(this.footerSec);
    if (p < -0.1 || p > 1.1) return;

    if (this.filingDrawer) {
      const enterT = Math.min(1, Math.max(0, (p - 0.20) / 0.45));
      let rx = 4.0 * (1 - enterT);
      let tz = -35 + enterT * 45;
      if (this.isMobile) {
        rx *= 0.35;
        tz = Math.max(-15, Math.min(12, tz));
      }
      this.filingDrawer.style.transform = `perspective(1000px) translate3d(0px, 0px, ${tz.toFixed(1)}px) rotateX(${rx.toFixed(2)}deg)`;
    }

    if (this.completionCard) {
      const enterT = Math.min(1, Math.max(0, (p - 0.35) / 0.35));
      const f_smooth = enterT * enterT * (3 - 2 * enterT);
      const tz = f_smooth * 16;
      this.completionCard.style.transform = `perspective(600px) translate3d(0px, 0px, ${tz.toFixed(1)}px)`;
      if (f_smooth > 0.1) {
        this.completionCard.style.boxShadow = `0 0 ${(f_smooth * 18).toFixed(1)}px rgba(184, 146, 58, ${(f_smooth * 0.4).toFixed(2)}), inset 0 0 ${(f_smooth * 12).toFixed(1)}px rgba(184, 146, 58, 0.15)`;
      } else {
        this.completionCard.style.boxShadow = '';
      }
    }
  }

  resetAllTransforms() {
    const all = [
      ...this.dossierCards,
      this.domainGrid,
      ...this.domainCards,
      this.resultsChamber,
      ...this.filmFrames,
      this.regTerminal,
      ...this.quartersCards,
      ...this.pillarCards,
      ...(this.sponsorCards || []),
      ...this.faqFolders,
      ...this.contactCards,
      this.filingDrawer,
      this.completionCard
    ];
    all.forEach(el => {
      if (el) {
        el.style.transform = '';
        el.style.boxShadow = '';
        el.style.borderColor = '';
        el.style.outline = '';
      }
    });
  }
}

class OverclockApp {
  constructor() {
    this.soundProfiles = ['tactile', 'tva-relay', 'sci-fi', 'typewriter'];
    const savedProfile = localStorage.getItem('oc2027_sound_profile');
    this.soundProfile = (savedProfile && this.soundProfiles.includes(savedProfile)) ? savedProfile : 'tva-relay';
    // Audio starts muted per browser autoplay standards; enabled on explicit user interaction
    const savedAudio = localStorage.getItem('oc2027_audio_enabled');
    this.audioEnabled = savedAudio === 'true';
    this.audioCtx = null;
    this.noiseBuffer = null;
    this.lastClickSoundTime = 0;
    this.hasBooted = sessionStorage.getItem('oc2027_booted') === 'true' || new URLSearchParams(window.location.search).has('skipboot');
    this.isHomepageActive = false;
    this.clockInterval = null;
    
    // Sponsors state
    this.sponsorsStamped = false;

    // Active Section & HUD state
    this.currentActiveSection = 'hero';
    this.countdownStarted = false;
    this.sectionLabels = {
      'hero': 'HOME',
      'about': 'ABOUT',
      'problems': 'DOMAINS',
      'results': 'RESULTS',
      'timeline': 'TIMELINE',
      'registration': 'REGISTER',
      'accommodation': 'STAY',
      'judging': 'JUDGING',
      'sponsors': 'SPONSORS',
      'faq': 'FAQ',
      'contact': 'CONTACT'
    };

    this.init();
  }

  init() {
    const urlParams = new URLSearchParams(window.location.search);
    const scrollTarget = window.location.hash || urlParams.get('goto');
    const scrollYParam = urlParams.get('scroll');

    if (!scrollTarget && !scrollYParam) {
      try {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      } catch (e) {
        window.scrollTo(0, 0);
      }
      document.documentElement.scrollTop = 0;
      if (document.body) document.body.scrollTop = 0;
    } else if (scrollYParam === 'bottom') {
      window.scrollTo(0, document.body.scrollHeight || 999999);
    } else if (scrollYParam) {
      const sY = parseInt(scrollYParam, 10);
      window.scrollTo(0, sY);
    }

    this.setupAudio();
    this.setupGlobalClickSound();
    this.setupBootSequence();
    this.setupHeroClock();
    this.setupTemporalClockNavigator();
    this.setupTimelineReveals();
    this.setupScrollAnimations();
    this.spatialController = new BureauSpatialScrollController(this);
    this.setupRegistrationCTA();
    this.setupDownloadsSection();
    this.setupUnstopLinks();
    this.setupTvaClubCards();
    this.setupSponsorsSection();
    this.setupFAQ();
    this.setupModals();
    this.setupMobileNav();
    this.setupMissMinutesOverlay();
    this.setupReplayIntro();
  }

  /* ==========================================================
     1. WEB AUDIO SYNTHESIZER & MULTI-PROFILE ACOUSTIC SYSTEM
  ========================================================== */
  ensureAudioContext() {
    if (!this.audioCtx) {
      if (window.TVATemporalIntro && window.TVATemporalIntro.audioCtx) {
        this.audioCtx = window.TVATemporalIntro.audioCtx;
      } else {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          this.audioCtx = new AudioContextClass();
        }
      }
    }
    if (this.audioCtx && this.audioCtx.state === 'suspended') {
      try { this.audioCtx.resume(); } catch (e) {}
    }
    return this.audioCtx;
  }

  createNoiseBuffer() {
    if (this.noiseBuffer) return this.noiseBuffer;
    const sampleRate = this.audioCtx ? this.audioCtx.sampleRate : 44100;
    const bufferSize = Math.floor(sampleRate * 0.04); // 40ms noise buffer
    const buffer = this.audioCtx.createBuffer(1, bufferSize, sampleRate);
    const output = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      output[i] = Math.random() * 2 - 1;
    }
    this.noiseBuffer = buffer;
    return buffer;
  }

  setupAudio() {
    const audioBtn = document.getElementById('audio-toggle-btn');
    if (!audioBtn) return;

    this.updateAudioBtnUI = () => {
      const isSoundOn = this.audioEnabled;
      const speakerOnSvg = `<svg class="audio-toggle-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>`;
      const speakerOffSvg = `<svg class="audio-toggle-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line><line x1="17" y1="9" x2="23" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line></svg>`;

      if (isSoundOn) {
        audioBtn.innerHTML = speakerOnSvg;
        audioBtn.classList.remove('muted');
        audioBtn.classList.add('audio-active');
        audioBtn.setAttribute('aria-label', 'Turn sound off');
        audioBtn.setAttribute('title', 'Turn sound off');
        audioBtn.setAttribute('aria-pressed', 'true');
      } else {
        audioBtn.innerHTML = speakerOffSvg;
        audioBtn.classList.add('muted');
        audioBtn.classList.remove('audio-active');
        audioBtn.setAttribute('aria-label', 'Turn sound on');
        audioBtn.setAttribute('title', 'Turn sound on');
        audioBtn.setAttribute('aria-pressed', 'false');
      }
    };

    this.updateAudioBtnUI();

    audioBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      this.toggleAudio();
    });
  }

  toggleAudio() {
    this.audioEnabled = !this.audioEnabled;
    try {
      localStorage.setItem('oc2027_audio_enabled', this.audioEnabled ? 'true' : 'false');
    } catch (err) {}

    if (this.audioEnabled) {
      const ctx = this.ensureAudioContext();
      if (ctx && ctx.state === 'suspended') {
        try { ctx.resume(); } catch (e) {}
      }
      if (window.TVATemporalIntro) {
        window.TVATemporalIntro.isAudioMuted = false;
        if (window.TVATemporalIntro.audioGain && window.TVATemporalIntro.audioCtx) {
          try {
            window.TVATemporalIntro.audioGain.gain.setValueAtTime(0.22, window.TVATemporalIntro.audioCtx.currentTime);
          } catch (e) {}
        }
      }
      if (this.updateAudioBtnUI) this.updateAudioBtnUI();
      this.playClickSound(null, true);
    } else {
      if (window.TVATemporalIntro) {
        window.TVATemporalIntro.isAudioMuted = true;
        if (window.TVATemporalIntro.audioGain && window.TVATemporalIntro.audioCtx) {
          try {
            window.TVATemporalIntro.audioGain.gain.setValueAtTime(0.0001, window.TVATemporalIntro.audioCtx.currentTime);
          } catch (e) {}
        }
      }
      if (this.updateAudioBtnUI) this.updateAudioBtnUI();
    }
  }

  setupGlobalClickSound() {
    this.lastClickSoundTime = 0;

    const onUserInteraction = (e) => {
      if (!this.audioEnabled) return;

      const now = performance.now();
      // Debounce rapid event fires within 25ms
      if (now - this.lastClickSoundTime < 25) return;
      this.lastClickSoundTime = now;

      this.ensureAudioContext();
      this.playClickSound(e.target);
    };

    // Capture phase on pointerdown guarantees instantaneous 0ms tactile response
    window.addEventListener('pointerdown', onUserInteraction, { capture: true, passive: true });
    // Keyboard activation (Enter/Space on focused interactive elements)
    window.addEventListener('click', (e) => {
      if (e.detail === 0) onUserInteraction(e);
    }, { capture: true, passive: true });

    // First interaction un-suspends AudioContext for smooth clock ticking
    const unlockAudio = () => {
      this.ensureAudioContext();
    };
    window.addEventListener('scroll', unlockAudio, { once: true, passive: true });
    window.addEventListener('touchstart', unlockAudio, { once: true, passive: true });
  }

  playClickSound(target = null, isPreview = false) {
    if (!this.audioEnabled || this.soundProfile === 'muted') return;
    const ctx = this.ensureAudioContext();
    if (!ctx) return;

    try {
      switch (this.soundProfile) {
        case 'tactile':
          this.playTactileTick(target);
          break;
        case 'tva-relay':
          this.playTVARelay(target);
          break;
        case 'sci-fi':
          this.playSciFiBlip(target);
          break;
        case 'typewriter':
          this.playTypewriterClack(target);
          break;
        default:
          this.playTactileTick(target);
      }
    } catch (e) {
      // Audio safety fallback
    }
  }

  /* --- PROFILE 1: Modern Tactile Haptic Tap (Apple / High-end Mechanical Switch) --- */
  playTactileTick(target) {
    const ctx = this.audioCtx;
    if (!ctx) return;
    const now = ctx.currentTime;

    const isButton = target && target.closest('a, button, .btn, .cta-button, .sector-link');
    const filterFreq = isButton ? 3400 : 3100;

    // Layer 1: Filtered micro-noise burst (sharp 3ms tactile snap, no pitch chirp)
    const noise = ctx.createBufferSource();
    noise.buffer = this.createNoiseBuffer();

    const bandpass = ctx.createBiquadFilter();
    bandpass.type = 'bandpass';
    bandpass.frequency.setValueAtTime(filterFreq + (Math.random() - 0.5) * 300, now);
    bandpass.Q.setValueAtTime(2.2, now);

    const noiseGain = ctx.createGain();
    noiseGain.gain.setValueAtTime(0.09, now);
    noiseGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.008);

    noise.connect(bandpass);
    bandpass.connect(noiseGain);
    noiseGain.connect(ctx.destination);
    noise.start(now);
    noise.stop(now + 0.01);

    // Layer 2: Subtle low tactile haptic body (180Hz sine decaying in 12ms)
    const osc = ctx.createOscillator();
    const oscGain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(isButton ? 190 : 160, now);
    osc.frequency.exponentialRampToValueAtTime(50, now + 0.012);

    oscGain.gain.setValueAtTime(0.08, now);
    oscGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.012);

    osc.connect(oscGain);
    oscGain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + 0.015);
  }

  /* --- PROFILE 2: Vintage TVA Industrial Solenoid Relay --- */
  playTVARelay(target) {
    const ctx = this.audioCtx;
    if (!ctx) return;
    const now = ctx.currentTime;

    // Metallic microswitch contact
    const osc1 = ctx.createOscillator();
    const gain1 = ctx.createGain();
    osc1.type = 'square';
    osc1.frequency.setValueAtTime(1900 + (Math.random() - 0.5) * 150, now);

    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(2400, now);
    filter.Q.setValueAtTime(3.8, now);

    gain1.gain.setValueAtTime(0.07, now);
    gain1.gain.exponentialRampToValueAtTime(0.0001, now + 0.016);

    osc1.connect(filter);
    filter.connect(gain1);
    gain1.connect(ctx.destination);
    osc1.start(now);
    osc1.stop(now + 0.018);

    // Magnetic solenoid core thunk
    const osc2 = ctx.createOscillator();
    const gain2 = ctx.createGain();
    osc2.type = 'triangle';
    osc2.frequency.setValueAtTime(110, now);
    osc2.frequency.exponentialRampToValueAtTime(38, now + 0.035);

    gain2.gain.setValueAtTime(0.14, now);
    gain2.gain.exponentialRampToValueAtTime(0.0001, now + 0.035);

    osc2.connect(gain2);
    gain2.connect(ctx.destination);
    osc2.start(now);
    osc2.stop(now + 0.038);
  }

  /* --- PROFILE 3: Futuristic Sci-Fi Quantum Blip / Crystal Glass Chime --- */
  playSciFiBlip(target) {
    const ctx = this.audioCtx;
    if (!ctx) return;
    const now = ctx.currentTime;

    const baseFreq = target && target.closest('a, button, .btn') ? 1980 : 1760;
    [1, 2.02].forEach((mult, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(baseFreq * mult, now);

      const vol = i === 0 ? 0.08 : 0.04;
      gain.gain.setValueAtTime(vol, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.042);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.045);
    });
  }

  /* --- PROFILE 4: Mechanical Typewriter Key Clack --- */
  playTypewriterClack(target) {
    const ctx = this.audioCtx;
    if (!ctx) return;
    const now = ctx.currentTime;

    // High metal striker impulse
    const noise = ctx.createBufferSource();
    noise.buffer = this.createNoiseBuffer();

    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(4600 + (Math.random() - 0.5) * 400, now);
    filter.Q.setValueAtTime(2.8, now);

    const gain = ctx.createGain();
    gain.gain.setValueAtTime(0.11, now);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.012);

    noise.connect(filter);
    filter.connect(gain);
    gain.connect(ctx.destination);
    noise.start(now);
    noise.stop(now + 0.015);

    // Damped platen body resonance
    const osc = ctx.createOscillator();
    const bodyGain = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(440, now);
    osc.frequency.exponentialRampToValueAtTime(120, now + 0.024);

    bodyGain.gain.setValueAtTime(0.07, now);
    bodyGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.024);

    osc.connect(bodyGain);
    bodyGain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + 0.026);
  }

  playRelayClick(freq = 1200) {
    this.playClickSound(null);
  }

  playStampThunk() {
    if (!this.audioEnabled || this.soundProfile === 'muted') return;
    const ctx = this.ensureAudioContext();
    if (!ctx) return;

    try {
      const now = ctx.currentTime;

      // 1. Crisp physical paper/ink contact click
      const click = ctx.createOscillator();
      const clickGain = ctx.createGain();
      click.type = 'triangle';
      click.frequency.setValueAtTime(1600, now);
      click.frequency.exponentialRampToValueAtTime(450, now + 0.015);

      clickGain.gain.setValueAtTime(0.08, now);
      clickGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.015);

      click.connect(clickGain);
      clickGain.connect(ctx.destination);
      click.start(now);
      click.stop(now + 0.018);

      // 2. Damped wooden desk / brass stamp weight
      const desk = ctx.createOscillator();
      const deskGain = ctx.createGain();
      desk.type = 'sine';
      desk.frequency.setValueAtTime(120, now);
      desk.frequency.exponentialRampToValueAtTime(48, now + 0.05);

      deskGain.gain.setValueAtTime(0.10, now);
      deskGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.055);

      desk.connect(deskGain);
      deskGain.connect(ctx.destination);
      desk.start(now);
      desk.stop(now + 0.06);
    } catch (e) {}
  }

  playHeroTitleArrival() {
    if (!this.audioEnabled || this.soundProfile === 'muted') return;
    const ctx = this.ensureAudioContext();
    if (!ctx) return;

    try {
      const now = ctx.currentTime;
      // Soft, organic split-flap cardstock fluttering (gentle mechanical card arrivals)
      const numFlaps = 9;
      for (let i = 0; i < numFlaps; i++) {
        const t = now + i * 0.038;
        
        // Filtered card micro-impulse
        const noise = ctx.createBufferSource();
        noise.buffer = this.createNoiseBuffer();
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(3600 + i * 40, t);
        filter.Q.setValueAtTime(2.2, t);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.028, t);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.014);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        noise.start(t);
        noise.stop(t + 0.016);
      }

      // Elegant TVA chronometer bell accent as the title finishes assembling
      setTimeout(() => {
        if (!this.audioEnabled || this.soundProfile === 'muted') return;
        const bellTime = ctx.currentTime;
        const bell = ctx.createOscillator();
        const bellGain = ctx.createGain();
        bell.type = 'sine';
        bell.frequency.setValueAtTime(587.33, bellTime); // D5 pure bell
        bellGain.gain.setValueAtTime(0.0001, bellTime);
        bellGain.gain.exponentialRampToValueAtTime(0.035, bellTime + 0.01);
        bellGain.gain.exponentialRampToValueAtTime(0.0001, bellTime + 0.65);

        bell.connect(bellGain);
        bellGain.connect(ctx.destination);
        bell.start(bellTime);
        bell.stop(bellTime + 0.7);

        this.playStampThunk();
      }, 380);
    } catch (e) {}
  }

  /* ==========================================================
     2. FAST BOOTLOADER SEQUENCE (MAX 2.5S)
  ========================================================== */
  setupBootSequence() {
    window.bureauApp = this;
    const tvaIntro = document.getElementById('tva-temporal-intro');
    if (tvaIntro && !tvaIntro.classList.contains('intro-complete')) {
      // The 3D TVA Temporal Entry Intro is active; it will trigger hero animations upon scene completion/handover
      return;
    }

    const overlay = document.getElementById('boot-overlay');
    if (!overlay) {
      this.triggerHeroAnimations();
      return;
    }

    if (this.hasBooted || window.location.search.includes('noboot') || window.location.search.includes('menu=open')) {
      overlay.classList.add('hidden');
      setTimeout(() => this.triggerHeroAnimations(), 50);
      return;
    }

    const finishBoot = () => {
      overlay.classList.add('hidden');
      sessionStorage.setItem('oc2027_booted', 'true');
      this.playRelayClick(880);
      setTimeout(() => this.triggerHeroAnimations(), 100);
    };

    overlay.addEventListener('click', finishBoot);
    window.addEventListener('keydown', finishBoot, { once: true });

    let step = 0;
    const interval = setInterval(() => {
      step++;
      if (step <= lines.length) {
        lines[step - 1].classList.add('active');
        if (fill) fill.style.width = `${(step / lines.length) * 100}%`;
        this.playRelayClick(600 + step * 150);
      } else {
        clearInterval(interval);
        setTimeout(finishBoot, 350);
      }
    }, 450);
  }

  triggerHeroAnimations() {
    try {
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    } catch (e) {
      window.scrollTo(0, 0);
    }
    document.documentElement.scrollTop = 0;
    if (document.body) document.body.scrollTop = 0;

    // Homepage is now active and directed
    this.isHomepageActive = true;
    this.ensureAudioContext();

    const heroSec = document.getElementById('hero');
    if (!heroSec || heroSec.classList.contains('hero-anim-active')) return;

    heroSec.classList.add('hero-anim-active');
    heroSec.classList.add('stamped');
    heroSec.classList.add('revealed');

