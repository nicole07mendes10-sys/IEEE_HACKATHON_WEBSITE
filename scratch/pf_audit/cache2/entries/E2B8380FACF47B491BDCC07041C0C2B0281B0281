        osc.connect(filter);
        filter.connect(chordGain);
        chordGain.connect(revealMaster);

        osc.start(now);
        osc.stop(now + 2.4);
      });

      // 3. Deep Velvet Sub Bass Pulse (Clean 52Hz -> 32Hz cinematic gravity lock)
      const subOsc = ctx.createOscillator();
      const subGain = ctx.createGain();
      subOsc.type = 'sine';
