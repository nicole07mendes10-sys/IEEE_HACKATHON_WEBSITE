      const lamp = block.querySelector('.status-lamp-mini');

      if (!btn) return;

      if (!url) {
        btn.setAttribute('disabled', 'true');
        btn.setAttribute('aria-disabled', 'true');
        btn.classList.add('is-pending');
        btn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.showRegistrationNotice('Official Unstop registration portal activates on 01 November 2026.');
        };
        if (statusText) {
          statusText.textContent = config.registrationPendingStatus || 'REGISTRATION PORTAL // OPENS 01 NOV 2026';
        }
        if (lamp) {
          lamp.classList.remove('live');
          lamp.classList.add('pending');
        }
      } else {
        btn.removeAttribute('disabled');
        btn.setAttribute('aria-disabled', 'false');
        btn.classList.remove('is-pending');
        btn.onclick = () => {
          window.open(url, '_blank', 'noopener,noreferrer');
        };
        if (statusText) {
          statusText.textContent = config.registrationLiveStatus || 'REGISTRATION PORTAL // OFFICIAL UNSTOP LIVE';
        }
        if (lamp) {
          lamp.classList.remove('pending');
          lamp.classList.add('live');
        }
      }
    });
  }

  /* Temporary toast / status banner for pending registration portal */
  showRegistrationNotice(message) {
    let notice = document.getElementById('bureau-toast-notice');
    if (!notice) {
      notice = document.createElement('div');
      notice.id = 'bureau-toast-notice';
      notice.className = 'bureau-toast-notice';
      notice.setAttribute('role', 'status');
      notice.setAttribute('aria-live', 'polite');
      document.body.appendChild(notice);
    }
    notice.textContent = message;
    notice.classList.add('is-visible');
    clearTimeout(this._toastTimer);
    this._toastTimer = setTimeout(() => {
      notice.classList.remove('is-visible');
    }, 4000);
  }

  /* ==========================================================
     5B. EVENT RESOURCES // DOWNLOADS INITIALIZER
     Configures brochure, PPT template, and rules PDF links.
     Maintains honest "AVAILABLE SOON" / "PDF PENDING" state
     when files are pending without broken links.
  ========================================================== */
  setupDownloadsSection() {
    const config = window.OVERCLOCK_CONFIG || {};
    const downloads = config.downloads || {};

    const items = [
      { key: 'participant-guide', data: downloads.participantGuide },
      { key: 'rules', data: downloads.rules },
      { key: 'ppt', data: downloads.pptTemplate }
    ];

    items.forEach(item => {
      const btn = document.getElementById(`btn-download-${item.key}`);
      const statusBadge = document.getElementById(`status-download-${item.key}`);
      const data = item.data || {};

      if (!btn) return;

      if (data.filePath) {
        btn.href = data.filePath;
        btn.download = '';
        btn.removeAttribute('aria-disabled');
        btn.classList.remove('is-pending');
        btn.classList.add('is-ready');
        btn.setAttribute('title', `Download ${data.title}`);
        const btnText = btn.querySelector('.download-btn-text');
        const isPptx = data.filePath.endsWith('.pptx');
        if (btnText) btnText.textContent = data.status || (isPptx ? 'DOWNLOAD PPTX' : 'DOWNLOAD PDF');

        if (statusBadge) {
          statusBadge.textContent = isPptx ? 'OFFICIAL PPTX' : 'OFFICIAL PDF';
          statusBadge.classList.remove('pending');
          statusBadge.classList.add('ready');
        }
      } else {
        btn.href = '#';
        btn.setAttribute('aria-disabled', 'true');
        btn.classList.add('is-pending');
        btn.classList.remove('is-ready');
        btn.setAttribute('title', `${data.title} — ${data.status || 'AVAILABLE SOON'}`);
        const btnText = btn.querySelector('.download-btn-text');
        if (btnText) btnText.textContent = data.status || 'AVAILABLE SOON';

        if (statusBadge) {
          statusBadge.textContent = data.status || 'PDF PENDING';
          statusBadge.classList.add('pending');
          statusBadge.classList.remove('ready');
        }

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          this.playRelayClick(750);
          this.showRegistrationNotice(`${data.title}: Official PDF file is pending release by the organizing committee.`);
        });
      }
    });

    this.setupRulesDossierModal();
  }

  /* ==========================================================
     5B-1. RULES & REGULATIONS DOSSIER MODAL
     Interactive reader for official Form OC-27 / RR (7 sections).
  ========================================================== */
  setupRulesDossierModal() {
    const modal = document.getElementById('rules-dossier-modal');
    if (!modal) return;

    const closeBtn = document.getElementById('rules-modal-close-btn');
    const bottomCloseBtn = document.getElementById('btn-close-rules-dossier-bottom');
    const openBtns = [
      document.getElementById('btn-open-rules-modal')
    ].filter(Boolean);

    let lastFocusedElement = null;

    const openDossier = (e) => {
      if (e) e.preventDefault();
      lastFocusedElement = document.activeElement;
      modal.removeAttribute('hidden');
      void modal.offsetWidth;
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      this.playRelayClick(1200);

      const scrollable = modal.querySelector('.rules-dossier-scroll');
      if (scrollable) scrollable.focus();
    };

    const closeDossier = () => {
      modal.classList.remove('open');
      document.body.style.overflow = '';
      this.playRelayClick(800);
      setTimeout(() => {
        if (!modal.classList.contains('open')) {
          modal.setAttribute('hidden', '');
        }
      }, 300);

      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      }
    };

    openBtns.forEach(btn => {
      btn.addEventListener('click', openDossier);
    });

    if (closeBtn) closeBtn.addEventListener('click', closeDossier);
    if (bottomCloseBtn) bottomCloseBtn.addEventListener('click', closeDossier);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeDossier();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeDossier();
      }
    });
  }

  /* ==========================================================
     5C. UNSTOP PLATFORM / EVENT LINKS INITIALIZER
     Ensures header and footer Unstop links route appropriately.
  ========================================================== */
  setupUnstopLinks() {
    const config = window.OVERCLOCK_CONFIG || {};
    const eventUrl = config.UNSTOP_EVENT_URL || config.registrationUrl;
    const platformUrl = config.UNSTOP_PLATFORM_URL || 'https://unstop.com';

    const headerLink = document.getElementById('header-unstop-link');
    const footerLink = document.getElementById('footer-unstop-link');

    [headerLink, footerLink].forEach(link => {
      if (!link) return;
      link.href = eventUrl || platformUrl;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      if (eventUrl) {
        link.setAttribute('title', 'Official OVERCLOCK 2027 Registration on Unstop');
      } else {
        link.setAttribute('title', 'Unstop — Official Hackathon Platform Partner');
      }
    });
  }

  /* ==========================================================
     6. SPONSORS ("AUTHORIZED PARTNERS") SECTION
  ========================================================== */
  setupSponsorsSection() {
    const container = document.getElementById('sponsors-tier-container');
    const contactBtn = document.getElementById('sponsor-contact-btn');
    const brochureBtn = document.getElementById('sponsor-brochure-btn');

    if (!container || typeof window.getSponsorsData !== 'function') return;

    const sponsors = window.getSponsorsData();
    const config = window.SPONSORS_CONFIG || {};

    // Setup action buttons
    if (contactBtn && config.sponsorContactEmail) {
      contactBtn.href = config.sponsorContactEmail;
    }
    if (brochureBtn) {
      if (config.brochureUrl) {
        brochureBtn.href = config.brochureUrl;
        brochureBtn.style.display = 'inline-flex';
      } else {
        brochureBtn.style.display = 'none';
      }
    }

    // Group sponsors by tiers
    container.innerHTML = '';
    const tiers = config.tiers || [];

    tiers.forEach(tierDef => {
      const tierSponsors = sponsors.filter(s => s.tier === tierDef.id);
      
      // Automatic rule: hide tier if 0 sponsors
      if (tierSponsors.length === 0) return;

      const groupEl = document.createElement('div');
      groupEl.className = 'tier-section-group';

      // Tier Divider Label
      const labelEl = document.createElement('div');
      labelEl.className = 'tier-divider-label';
      labelEl.textContent = tierDef.title;
      groupEl.appendChild(labelEl);

      // Grid Container based on Tier
      const gridEl = document.createElement('div');
      if (tierDef.id === 'TITLE') {
        gridEl.className = 'tier-title-container';
      } else if (tierDef.id === 'GOLD') {
        gridEl.className = 'tier-gold-grid';
      } else {
        gridEl.className = 'tier-silver-grid';
      }

      tierSponsors.forEach((sponsor, sIdx) => {
        const card = document.createElement('a');
        card.href = sponsor.url || '#';
        card.target = sponsor.url && sponsor.url !== '#' ? '_blank' : '_self';
        card.rel = 'noopener noreferrer';
        card.className = `auth-clearance-card ${tierDef.cardClass}`;
        card.dataset.sponsorIndex = sIdx;

        // Pushpin
        const pushpin = document.createElement('div');
        pushpin.className = 'card-pushpin-head';
        card.appendChild(pushpin);

        // Auth Clearance No
        const authNum = document.createElement('div');
        authNum.className = 'card-auth-number';
        authNum.textContent = `AUTH. NO. ${sponsor.id}`;
        card.appendChild(authNum);

        // Logo Container
        const logoBox = document.createElement('div');
        logoBox.className = 'card-logo-container';
        if (sponsor.logo) {
          const img = document.createElement('img');
          img.src = sponsor.logo;
          img.alt = `${sponsor.name} Logo`;
          img.style.maxHeight = '80%';
          img.style.maxWidth = '80%';
          img.style.objectFit = 'contain';
          logoBox.appendChild(img);
        } else {
          const placeholder = document.createElement('span');
          placeholder.className = 'card-logo-placeholder-text';
          placeholder.textContent = 'LOGO';
          logoBox.appendChild(placeholder);
        }
        card.appendChild(logoBox);

        // Sponsor Name
        const nameEl = document.createElement('div');
        nameEl.className = 'card-sponsor-name';
        nameEl.textContent = sponsor.name;
        card.appendChild(nameEl);

        // Card Clearance Footer Strip (Badge + Approved Stamp side-by-side)
        const footerStrip = document.createElement('div');
        footerStrip.className = 'card-clearance-footer';

        const tierBadge = document.createElement('div');
        tierBadge.className = `card-tier-stamp ${tierDef.badgeClass}`;
        tierBadge.textContent = tierDef.stampText;
        footerStrip.appendChild(tierBadge);

        const stampWatermark = document.createElement('div');
        stampWatermark.className = 'card-approved-stamp';
        stampWatermark.textContent = 'APPROVED';
        footerStrip.appendChild(stampWatermark);

        card.appendChild(footerStrip);

        gridEl.appendChild(card);
      });

      groupEl.appendChild(gridEl);
      container.appendChild(groupEl);
    });

    if (this.spatialController) {
      this.spatialController.cacheSponsorCards();
    }
  }


  animateSponsorCards() {
    if (this.sponsorsStamped) return;
    this.sponsorsStamped = true;

    const cards = document.querySelectorAll('.auth-clearance-card');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      cards.forEach(c => {
        c.style.opacity = '1';
        c.style.transform = 'none';
        c.classList.add('revealed');
      });
      return;
    }

    cards.forEach((card, index) => {
      setTimeout(() => {
        card.style.transition = 'opacity 0.35s ease';
        card.style.opacity = '1';
        card.classList.add('scan-active');
        card.classList.add('revealed');
        if (index < 3) this.playStampThunk();
      }, index * 95);
    });
  }

  /* ==========================================================
     7. FAQ MANILA FOLDER TYPEWRITER EXPANSION
  ========================================================== */
  setupFAQ() {
    const folders = document.querySelectorAll('.case-folder-unit');
    folders.forEach(folder => {
      const bar = folder.querySelector('.folder-tab-bar');
      if (!bar) return;

      bar.addEventListener('click', () => {
        const wasOpen = folder.classList.contains('open');
        folders.forEach(f => {
          f.classList.remove('open');
          const indicator = f.querySelector('.folder-tab-bar span:last-child');
          if (indicator) indicator.textContent = '[EXPAND]';
        });
        if (!wasOpen) {
          folder.classList.add('open');
          const indicator = folder.querySelector('.folder-tab-bar span:last-child');
          if (indicator) indicator.textContent = '[OPEN]';
          this.playRelayClick(950);
        }
      });
    });
  }


  /* ==========================================================
     9. "OPEN A CASE FILE" MODAL
  ========================================================== */
  setupModals() {
    const modal = document.getElementById('case-file-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const triggers = document.querySelectorAll('.open-case-file-trigger');
    const form = document.getElementById('case-intake-form');

    if (!modal) return;

    const openModal = (e) => {
      if (e) {
        e.preventDefault();
