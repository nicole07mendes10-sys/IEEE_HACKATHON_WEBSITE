  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: rgba(36, 26, 18, 0.85);
  border: 1px solid rgba(217, 169, 58, 0.45);
  color: var(--mustard-secondary, #D9A93A);
  border-radius: var(--radius-sm, 4px);
  padding: 8px 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  width: 100%;
  box-sizing: border-box;
  transition: var(--transition-fast, 0.2s ease);
}

.btn-view-directive-modal:hover {
  background: #2d1f14;
  border-color: var(--amber-bright, #E8892B);
  color: var(--paper-cream, #F4ECD8);
  box-shadow: 0 0 10px rgba(232, 137, 43, 0.35);
}

/* 3. Rules Dossier Modal Container */
.rules-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(10, 8, 6, 0.92);
  backdrop-filter: blur(10px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.rules-modal-backdrop.open {
  opacity: 1;
  visibility: visible;
}

.rules-dossier-card {
  width: 100%;
  max-width: 860px;
  max-height: 90vh;
  background: #140f0a;
  border: 2px solid var(--border-brass, #A37B30);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9), 0 0 30px rgba(232, 137, 43, 0.15);
  position: relative;
  overflow: hidden;
  animation: rulesCardEnter 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes rulesCardEnter {
  from {
    opacity: 0;
    transform: scale(0.96) translateY(12px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* Modal Top Bar */
.rules-modal-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 18px;
  background: #1c140e;
  border-bottom: 1px solid rgba(217, 169, 58, 0.3);
  flex-shrink: 0;
}

.rules-topbar-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mustard-secondary, #D9A93A);
}

.rules-division-tag {
  color: var(--amber-bright, #E8892B);
}

.rules-bullet-sep {
  opacity: 0.5;
}

.rules-rev-pill {
  background: rgba(217, 169, 58, 0.2);
  padding: 1px 6px;
  border-radius: 2px;
  color: var(--paper-cream, #F4ECD8);
}

.rules-stamp-pill {
  background: rgba(124, 255, 155, 0.15);
  border: 1px solid rgba(124, 255, 155, 0.4);
  color: #7CFF9B;
  padding: 1px 7px;
  border-radius: 2px;
  font-size: 0.62rem;
}

.rules-modal-close-btn {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-dim, #B5A48B);
  font-size: 1.3rem;
  line-height: 1;
  padding: 2px 8px;
  border-radius: 3px;
  cursor: pointer;
  transition: var(--transition-fast, 0.2s ease);
}

.rules-modal-close-btn:hover {
  color: var(--amber-bright, #E8892B);
  border-color: rgba(232, 137, 43, 0.5);
  background: rgba(232, 137, 43, 0.1);
}

/* Dossier Banner */
.rules-dossier-banner {
  padding: 20px 24px 16px;
  background: linear-gradient(180deg, #18110b 0%, #140f0a 100%);
  border-bottom: 1px dashed rgba(217, 169, 58, 0.35);
  flex-shrink: 0;
}

.rules-banner-classification {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--amber-bright, #E8892B);
  margin-bottom: 4px;
}

.rules-dossier-heading {
  font-family: var(--font-display, "Space Grotesk", sans-serif);
  font-size: 1.8rem;
  letter-spacing: 0.04em;
  color: var(--paper-cream, #F4ECD8);
  margin: 0;
  text-transform: uppercase;
}

.rules-dossier-subhead {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mustard-secondary, #D9A93A);
  margin-top: 2px;
}

.rules-banner-meta {
  font-family: var(--font-typewriter);
  font-size: 0.84rem;
  color: var(--text-dim, #B5A48B);
  margin: 6px 0 14px;
}

/* Telemetry Grid */
.rules-telemetry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.rules-tele-pill {
  background: #1c140d;
  border: 1px solid rgba(217, 169, 58, 0.3);
  border-radius: 4px;
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.rules-tele-k {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
  color: var(--text-muted, #7E7060);
  letter-spacing: 0.06em;
}

.rules-tele-v {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--paper-cream, #F4ECD8);
}

.rules-tele-v.tele-free {
  color: #7CFF9B;
}

.rules-tele-v.tele-cost {
  color: var(--amber-bright, #E8892B);
}

/* Scrollable Dossier Body */
.rules-dossier-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 22px;
  outline: none;
}

.rules-dossier-scroll::-webkit-scrollbar {
  width: 8px;
}

.rules-dossier-scroll::-webkit-scrollbar-track {
  background: #100c08;
}

.rules-dossier-scroll::-webkit-scrollbar-thumb {
  background: rgba(217, 169, 58, 0.35);
  border-radius: 4px;
}

.rules-dossier-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--amber-bright, #E8892B);
}

/* Section Blocks */
.rules-section-block {
  background: #17110b;
  border: 1px solid rgba(217, 169, 58, 0.3);
  border-radius: 4px;
  padding: 16px 18px;
  position: relative;
}

.rules-block-header {
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(217, 169, 58, 0.2);
  padding-bottom: 10px;
  margin-bottom: 12px;
}

.rules-block-num {
  font-family: var(--font-display, "Space Grotesk", sans-serif);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--amber-bright, #E8892B);
  line-height: 1;
}

.rules-block-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rules-block-title {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--paper-cream, #F4ECD8);
  margin: 0;
  letter-spacing: 0.05em;
}

.rules-file-ref {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--mustard-secondary, #D9A93A);
  letter-spacing: 0.06em;
}

.rules-block-status-stamp {
  font-family: var(--font-mono);
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 2px 7px;
  border-radius: 2px;
}

.rules-block-status-stamp.verified {
  background: rgba(124, 255, 155, 0.12);
  border: 1px solid rgba(124, 255, 155, 0.4);
  color: #7CFF9B;
}

.rules-block-status-stamp.rounds-stamp {
  background: rgba(217, 169, 58, 0.15);
  border: 1px solid rgba(217, 169, 58, 0.45);
  color: var(--mustard-secondary, #D9A93A);
}

.rules-block-status-stamp.spec-stamp {
  background: rgba(94, 204, 255, 0.12);
  border: 1px solid rgba(94, 204, 255, 0.4);
  color: #72D7FF;
}

.rules-block-status-stamp.mandatory-stamp {
  background: rgba(255, 99, 71, 0.15);
  border: 1px solid rgba(255, 99, 71, 0.5);
  color: #FF8566;
}

.rules-block-status-stamp.final-stamp {
  background: rgba(232, 137, 43, 0.15);
  border: 1px solid rgba(232, 137, 43, 0.5);
  color: var(--amber-bright, #E8892B);
}

.rules-block-status-stamp.general-stamp {
  background: rgba(181, 164, 139, 0.15);
  border: 1px solid rgba(181, 164, 139, 0.35);
  color: var(--text-dim, #B5A48B);
}

/* Clause List */
.rules-clause-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.rules-clause-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-family: var(--font-typewriter);
  font-size: 0.88rem;
  line-height: 1.5;
  color: var(--text-primary, #E3D7BF);
}

.clause-num {
  font-family: var(--font-mono);
  font-size: 0.70rem;
  font-weight: 700;
  background: #241a12;
  border: 1px solid rgba(217, 169, 58, 0.3);
  color: var(--amber-bright, #E8892B);
  padding: 1px 6px;
  border-radius: 2px;
  flex-shrink: 0;
  margin-top: 2px;
}

.clause-text strong {
  color: var(--paper-cream, #F4ECD8);
  font-weight: 700;
}

/* Round 1 & Round 2 Subcards */
.rules-round-subcard {
  background: #120e09;
  border: 1px solid rgba(217, 169, 58, 0.25);
  border-radius: 4px;
  padding: 14px 16px;
  margin-top: 12px;
}

.round-1-subcard {
  border-left: 3px solid #7CFF9B;
}

.round-2-subcard {
  border-left: 3px solid var(--amber-bright, #E8892B);
}

.round-subcard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px dashed rgba(217, 169, 58, 0.2);
}

.round-subcard-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--paper-cream, #F4ECD8);
  letter-spacing: 0.05em;
}

.round-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.round-dot.green {
  background: #7CFF9B;
  box-shadow: 0 0 6px #7CFF9B;
}

.round-dot.amber {
  background: var(--amber-bright, #E8892B);
  box-shadow: 0 0 6px var(--amber-bright, #E8892B);
}

.round-fee-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
}

.round-fee-badge.free .fee-big {
  font-family: var(--font-mono);
  font-size: 1.1rem;
  font-weight: 800;
  color: #7CFF9B;
}

.round-fee-badge.paid .fee-big {
  font-family: var(--font-mono);
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--amber-bright, #E8892B);
}

.round-fee-badge .fee-sub {
  font-family: var(--font-mono);
  font-size: 0.64rem;
  color: var(--text-muted, #7E7060);
}

.round-fee-inclusions-note {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: #7CFF9B;
  background: rgba(124, 255, 155, 0.08);
  border: 1px solid rgba(124, 255, 155, 0.25);
  border-radius: 3px;
  padding: 6px 10px;
  margin-bottom: 12px;
}

/* Final Stabilization Seal */
.rules-timeline-seal {
  background: linear-gradient(135deg, rgba(232, 137, 43, 0.08) 0%, #16100a 100%);
  border: 1px dashed var(--border-brass, #A37B30);
  border-radius: 4px;
  padding: 16px 20px;
  text-align: center;
}

.seal-diamond-symbol {
  font-family: var(--font-mono);
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--amber-bright, #E8892B);
  letter-spacing: 0.1em;
  margin-bottom: 6px;
}

.seal-directive-text {
  font-family: var(--font-typewriter);
  font-size: 0.86rem;
  color: var(--paper-cream, #F4ECD8);
  margin: 0 0 8px;
  line-height: 1.45;
}

.seal-footnote {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--mustard-secondary, #D9A93A);
  letter-spacing: 0.06em;
}

/* Modal Bottom Actions */
.rules-modal-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  padding: 14px 24px;
  background: #18120c;
  border-top: 1px solid rgba(217, 169, 58, 0.3);
  flex-shrink: 0;
}

.btn-dossier-download,
.btn-dossier-tab,
.btn-dossier-close {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-decoration: none;
  padding: 9px 16px;
  border-radius: 4px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: var(--transition-fast, 0.2s ease);
}

.btn-dossier-download {
  background: linear-gradient(180deg, #E8892B 0%, #B86518 100%);
  color: #14100C;
  border: 1px solid #FFB347;
}

.btn-dossier-download:hover {
  background: linear-gradient(180deg, #FFA347 0%, #C9721D 100%);
  box-shadow: 0 0 14px rgba(232, 137, 43, 0.6);
}

.btn-dossier-tab {
  background: #241a12;
  border: 1px solid rgba(217, 169, 58, 0.4);
  color: var(--paper-cream, #F4ECD8);
}

.btn-dossier-tab:hover {
  border-color: var(--amber-bright, #E8892B);
  color: var(--amber-bright, #E8892B);
  background: #2e2016;
}

.btn-dossier-close {
  background: transparent;
  border: 1px solid rgba(181, 164, 139, 0.3);
  color: var(--text-dim, #B5A48B);
}

.btn-dossier-close:hover {
  border-color: var(--paper-cream, #F4ECD8);
  color: var(--paper-cream, #F4ECD8);
}

/* Responsiveness for Dossier Modal */
@media (max-width: 768px) {
  .registration-directive-callout {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .directive-callout-actions {
    width: 100%;
  }
  
  .btn-directive-open,
  .btn-directive-dl {
    width: 100%;
  }

  .rules-telemetry-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .rules-modal-actions {
    flex-direction: column;
    gap: 8px;
  }

  .btn-dossier-download,
  .btn-dossier-tab,
  .btn-dossier-close {
    width: 100%;
    justify-content: center;
  }
}

/* ==========================================================
   DOMAIN ACOUSTIC & HAPTIC VIBRATION STYLES (6 DOMAIN SLOTS)
========================================================== */

/* 1. Domain Sonic Telemetry Ribbon */
.domain-sonic-telemetry-ribbon {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: linear-gradient(90deg, rgba(232, 137, 43, 0.12) 0%, rgba(20, 15, 11, 0.95) 100%);
  border: 1px solid rgba(217, 169, 58, 0.35);
  border-left: 4px solid var(--amber-bright, #E8892B);
  border-radius: var(--radius-sm, 4px);
  padding: 10px 18px;
  margin: 0 0 24px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
}

.sonic-ribbon-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sonic-pulse-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--amber-bright, #E8892B);
  box-shadow: 0 0 10px var(--amber-bright, #E8892B);
  animation: sonicDotPulse 1.2s infinite ease-in-out;
}

@keyframes sonicDotPulse {
  0%, 100% { opacity: 0.5; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.2); }
}

.sonic-ribbon-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--paper-cream, #F4ECD8);
}

.sonic-ribbon-right {
  font-family: var(--font-typewriter);
  font-size: 0.82rem;
  color: var(--mustard-secondary, #D9A93A);
  letter-spacing: 0.02em;
}

/* 2. Topbar Sonic Wave Voice Button */
.slot-sonic-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mustard-secondary, #D9A93A);
  background: rgba(30, 22, 14, 0.85);
  border: 1px solid rgba(217, 169, 58, 0.3);
  padding: 3px 8px;
  border-radius: 3px;
  cursor: pointer;
  transition: all 0.2s ease;
  user-select: none;
  line-height: 1.2;
}

.domain-slot-card:hover .slot-sonic-btn,
.domain-slot-card.scope-probed .slot-sonic-btn,
.domain-slot-card.sonic-active .slot-sonic-btn {
  border-color: var(--amber-bright, #E8892B);
  color: var(--paper-cream, #F4ECD8);
  background: rgba(232, 137, 43, 0.22);
  box-shadow: 0 0 10px rgba(232, 137, 43, 0.4);
}

.slot-amber.sonic-active .slot-sonic-btn { border-color: #FFB347; color: #FFB347; box-shadow: 0 0 8px rgba(255, 157, 59, 0.6); }
.slot-cyan.sonic-active .slot-sonic-btn { border-color: #00E5FF; color: #00E5FF; box-shadow: 0 0 8px rgba(0, 229, 255, 0.6); }
.slot-emerald.sonic-active .slot-sonic-btn { border-color: #00E676; color: #00E676; box-shadow: 0 0 8px rgba(0, 230, 118, 0.6); }
.slot-violet.sonic-active .slot-sonic-btn { border-color: #BB86FC; color: #BB86FC; box-shadow: 0 0 8px rgba(187, 134, 252, 0.6); }
.slot-copper.sonic-active .slot-sonic-btn { border-color: #FF8C42; color: #FF8C42; box-shadow: 0 0 8px rgba(255, 140, 66, 0.6); }
.slot-ruby.sonic-active .slot-sonic-btn { border-color: #FF4B6E; color: #FF4B6E; box-shadow: 0 0 8px rgba(255, 75, 110, 0.6); }

/* Animated Sonic Equalizer Bars */
.sonic-bars {
  display: inline-flex;
  align-items: flex-end;
  gap: 2px;
  height: 10px;
}

.sonic-bars span {
  width: 2px;
  height: 3px;
  background: currentColor;
  border-radius: 1px;
  transition: height 0.12s ease;
}

.domain-slot-card.sonic-active .sonic-bars span:nth-child(1) {
  animation: sonicEqBar1 0.36s infinite alternate ease-in-out;
}
.domain-slot-card.sonic-active .sonic-bars span:nth-child(2) {
  animation: sonicEqBar2 0.28s infinite alternate ease-in-out 0.08s;
}
.domain-slot-card.sonic-active .sonic-bars span:nth-child(3) {
  animation: sonicEqBar3 0.42s infinite alternate ease-in-out 0.16s;
}

@keyframes sonicEqBar1 { 0% { height: 3px; } 100% { height: 10px; } }
@keyframes sonicEqBar2 { 0% { height: 4px; } 100% { height: 9px; } }
@keyframes sonicEqBar3 { 0% { height: 2px; } 100% { height: 11px; } }

/* 3. CRT Phosphor Micro-Tremor (Visual Vibration Feedback) */
@keyframes scopePhosphorShake {
  0% { transform: translate(0, 0); }
  25% { transform: translate(-0.6px, 0.5px); }
  50% { transform: translate(0.5px, -0.6px); }
  75% { transform: translate(-0.5px, -0.4px); }
  100% { transform: translate(0, 0); }
}

.domain-slot-card.sonic-active .domain-screen-display {
  animation: scopePhosphorShake 0.12s infinite linear;
}

@media (max-width: 768px) {
  .domain-sonic-telemetry-ribbon {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
}

/* ==========================================================
   13. DEVELOPERS // TECHNICAL TEAM (DEDICATED SECTION)
   Aesthetic: TVA Retro-Futuristic Dossier & Golden Spine Extension
========================================================== */
.developers-section {
  position: relative;
  background: radial-gradient(ellipse at 50% 0%, #18120c 0%, #0a0705 100%);
  border-top: 3px solid var(--border-brass, #D9A93A);
  padding: 80px 24px 44px;
  box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.85);
  z-index: 10;
}

.developers-container {
  max-width: var(--container-max, 1240px);
  margin: 0 auto;
  padding: 0 16px;
  box-sizing: border-box;
}

.developers-header-wrap,
.bureau-section.developers-section .section-header-wrap {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 44px;
  opacity: 1 !important;
  transform: none !important;
}

.developers-main-heading {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  letter-spacing: 0.06em;
  line-height: 1.05;
  color: var(--amber-bright, #FF9D3B);
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85), 0 0 20px rgba(232, 137, 43, 0.25);
  margin: 10px 0 8px;
}

.developers-team-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 12px;
  background: rgba(26, 20, 14, 0.85);
  border: 1px solid rgba(217, 169, 58, 0.4);
  border-radius: var(--radius-sm, 4px);
  margin-bottom: 12px;
}

.developers-team-badge .dev-badge-pip {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--amber-bright, #FF9D3B);
  box-shadow: 0 0 8px var(--amber-bright, #FF9D3B);
}

.developers-team-badge .dev-badge-text {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--paper-cream, #EFE6D2);
  text-transform: uppercase;
}

.developers-intro {
  font-family: var(--font-typewriter);
  font-size: 0.98rem;
  color: var(--text-muted, #B8A890);
  line-height: 1.55;
  margin: 0 auto;
}

/* Two Developer Cards Grid */
.developers-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
  max-width: 880px;
  margin: 0 auto 36px;
}

.developer-card {
  background: #140e0a;
  border: 1px solid rgba(217, 169, 58, 0.28);
  border-left: 3px solid var(--border-brass, #D9A93A);
  border-radius: var(--radius-md, 8px);
  padding: 24px 22px 22px;
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65),
              inset 0 0 16px rgba(217, 169, 58, 0.03);
  transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
}

.developer-card:hover {
  transform: translateY(-3px);
  border-color: rgba(232, 137, 43, 0.6);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.8),
              0 0 18px rgba(232, 137, 43, 0.16);
}

.developer-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.developer-id-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--amber-bright, #FF9D3B);
  background: rgba(232, 137, 43, 0.12);
  border: 1px solid rgba(217, 169, 58, 0.4);
  padding: 3px 8px;
  border-radius: var(--radius-sm, 3px);
  text-transform: uppercase;
}

.developer-sys-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  color: var(--text-dim, #7A6F60);
  text-transform: uppercase;
}

.developer-name {
  font-family: var(--font-display, var(--font-sans));
  font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  color: var(--paper-cream, #EFE6D2);
  font-weight: 700;
  letter-spacing: 0.03em;
  margin: 0 0 4px;
  line-height: 1.2;
}

.developer-role {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mustard-secondary, #D9A93A);
  text-transform: uppercase;
  margin: 0 0 16px;
}

.developer-card-divider {
  width: 100%;
  border-top: 1px dashed rgba(217, 169, 58, 0.22);
  margin: 4px 0 16px;
}

.developer-contact-block {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.developer-phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}

.developer-phone-label {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  color: var(--text-dim, #7A6F60);
  text-transform: uppercase;
}

.developer-phone-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-mono);
  font-size: 0.84rem;
  font-weight: 600;
  color: #FFD27D;
  text-decoration: none;
  padding: 6px 12px;
  border-radius: var(--radius-sm, 4px);
  background: rgba(224, 138, 46, 0.08);
  border: 1px solid rgba(217, 169, 58, 0.3);
  transition: all 0.2s ease;
  letter-spacing: 0.03em;
  min-height: 38px;
  box-sizing: border-box;
}

.developer-phone-link:hover,
.developer-phone-link:focus-visible {
  color: #FFFFFF;
  background: rgba(224, 138, 46, 0.24);
  border-color: var(--amber-bright, #FF9D3B);
  box-shadow: 0 0 12px rgba(245, 166, 35, 0.35);
  outline: none;
}

.developer-phone-link .dev-phone-icon {
  display: flex;
  align-items: center;
  color: var(--mustard-secondary, #D9A93A);
}

.developer-action-row {
  width: 100%;
}

.developer-github-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  width: 100%;
  box-sizing: border-box;
  padding: 11px 16px;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #FFF4DC;
  background: linear-gradient(180deg, #1d1611 0%, #130d09 100%);
  border: 1.5px solid rgba(217, 169, 58, 0.45);
  border-radius: var(--radius-sm, 4px);
  text-decoration: none;
  cursor: pointer;
  transition: all 0.22s ease;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
  min-height: 44px;
}

.developer-github-btn:hover,
.developer-github-btn:focus-visible {
  background: rgba(232, 137, 43, 0.22);
  border-color: var(--amber-bright, #FF9D3B);
  color: #FFFFFF;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.8),
              0 0 14px rgba(245, 166, 35, 0.4);
  transform: translateY(-2px);
  outline: none;
}

.developer-github-btn .dev-gh-icon {
  display: flex;
  align-items: center;
  color: var(--amber-bright, #FF9D3B);
  transition: color 0.2s ease;
}

.developer-github-btn:hover .dev-gh-icon {
  color: #FFFFFF;
}

.developer-github-btn .dev-gh-arrow {
  font-size: 0.95rem;
  color: var(--mustard-secondary, #D9A93A);
  transition: transform 0.2s ease;
}

.developer-github-btn:hover .dev-gh-arrow {
  transform: translate(2px, -2px);
  color: #FFFFFF;
}

.developers-action-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 0 24px;
}

.developers-bottom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-top: 1px solid rgba(217, 169, 58, 0.18);
  padding-top: 18px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-dim, #7A6F60);
  flex-wrap: wrap;
  text-align: center;
}

.developers-bottom-bar .dev-bottom-tag {
  color: var(--paper-cream, #EFE6D2);
  letter-spacing: 0.06em;
  font-weight: 600;
}

.developers-bottom-bar .dev-bottom-divider {
  color: rgba(217, 169, 58, 0.35);
}

.developers-bottom-bar .dev-bottom-note {
  letter-spacing: 0.04em;
}

/* ==========================================================
   DEVELOPERS RECOGNITION PANEL (MODAL OVERLAY)
   TVA-Inspired Centered Recognition Modal
========================================================== */
body.dev-modal-open {
  overflow: hidden !important;
}

.developers-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
  box-sizing: border-box;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
              visibility 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.developers-modal-overlay[hidden] {
  display: none !important;
}

.developers-modal-overlay.is-active {
  opacity: 1;
  visibility: visible;
}

.dev-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(8, 6, 4, 0.88);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.dev-modal-container {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 820px;
  max-height: 90vh;
  overflow-y: auto;
  overscroll-behavior: contain;
  box-sizing: border-box;
  transform: scale(0.96) translateY(12px);
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  scrollbar-width: thin;
  scrollbar-color: rgba(217, 169, 58, 0.5) rgba(20, 14, 10, 0.8);
}

.dev-modal-container::-webkit-scrollbar {
  width: 6px;
}
.dev-modal-container::-webkit-scrollbar-track {
  background: rgba(20, 14, 10, 0.8);
  border-radius: 3px;
}
.dev-modal-container::-webkit-scrollbar-thumb {
  background: rgba(217, 169, 58, 0.5);
  border-radius: 3px;
}
.dev-modal-container::-webkit-scrollbar-thumb:hover {
  background: var(--amber-bright, #FF9D3B);
}

.developers-modal-overlay.is-active .dev-modal-container {
  transform: scale(1) translateY(0);
}

.dev-modal-surface {
  position: relative;
  background: #120d09;
  border: 1px solid rgba(217, 169, 58, 0.45);
  border-radius: var(--radius-md, 6px);
  padding: 30px 28px 24px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.9), 0 0 40px rgba(232, 137, 43, 0.2);
  box-sizing: border-box;
}

/* Corner brass bracket accents */
.modal-bracket {
  position: absolute;
  width: 12px;
  height: 12px;
  border: 2px solid var(--amber-bright, #FF9D3B);
  pointer-events: none;
}
.modal-bracket.top-left { top: -1px; left: -1px; border-right: none; border-bottom: none; }
.modal-bracket.top-right { top: -1px; right: -1px; border-left: none; border-bottom: none; }
.modal-bracket.bottom-left { bottom: -1px; left: -1px; border-right: none; border-top: none; }
.modal-bracket.bottom-right { bottom: -1px; right: -1px; border-left: none; border-top: none; }

.dev-modal-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 1px dashed rgba(217, 169, 58, 0.25);
  gap: 12px;
}

.dev-modal-file-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mustard-secondary, #e5a93c);
  text-transform: uppercase;
}

.dev-modal-file-tag .dev-tag-lamp {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--amber-bright, #FF9D3B);
  box-shadow: 0 0 6px var(--amber-bright, #FF9D3B);
}

.dev-modal-close-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  min-width: 36px;
  min-height: 36px;
  padding: 0;
  background: rgba(26, 20, 14, 0.85);
  border: 1px solid rgba(217, 169, 58, 0.4);
  border-radius: var(--radius-sm, 3px);
  color: var(--paper-cream, #EFE6D2);
  font-family: var(--font-mono);
  font-size: 1.15rem;
  line-height: 1;
  cursor: pointer;
  transition: all 0.2s ease;
}

.dev-modal-close-btn:hover,
.dev-modal-close-btn:focus-visible {
  background: rgba(232, 137, 43, 0.25);
  border-color: var(--amber-bright, #FF9D3B);
  color: var(--amber-bright, #FF9D3B);
  box-shadow: 0 0 12px rgba(245, 166, 35, 0.35);
  outline: none;
}

.dev-modal-header {
  text-align: center;
  margin-bottom: 26px;
}

.dev-modal-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  letter-spacing: 0.06em;
  color: var(--amber-bright, #FF9D3B);
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8), 0 0 18px rgba(232, 137, 43, 0.25);
  margin: 0 0 8px;
  line-height: 1.1;
  text-transform: uppercase;
}

.dev-modal-title .dev-title-divider {
  color: var(--mustard-secondary, #e5a93c);
  opacity: 0.65;
}

.dev-modal-intro {
  font-family: var(--font-typewriter);
  font-size: 0.94rem;
  color: var(--text-muted, #B8A890);
  line-height: 1.5;
  margin: 0 auto;
  max-width: 620px;
}

.dev-modal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 20px;
}

.dev-modal-bottom-note {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  padding-top: 16px;
  border-top: 1px dashed rgba(217, 169, 58, 0.2);
  font-family: var(--font-mono);
  font-size: 0.70rem;
  letter-spacing: 0.08em;
  color: rgba(217, 169, 58, 0.65);
  text-align: center;
  flex-wrap: wrap;
}



