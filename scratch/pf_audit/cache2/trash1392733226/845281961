.tva-close-btn:hover {
  color: var(--paper-cream);
  border-color: var(--border-subtle);
  background: rgba(239, 230, 210, 0.08);
}

.tva-close-btn:focus-visible {
  outline: 2px solid var(--amber-bright);
  outline-offset: 2px;
}

/* TVA Terminal Live Notification Broadcast */
.tva-terminal-notice {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 18px;
  background: #120D09;
  border-bottom: 1px solid rgba(217, 169, 58, 0.25);
  font-family: var(--tva-font-mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--paper-cream);
  z-index: 9;
  position: relative;
  min-height: 34px;
  line-height: 1.4;
  transition: background 0.2s ease;
}

.tva-terminal-notice:empty {
  display: none;
}

.tva-terminal-notice::before {
  content: '';
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--amber-bright);
  box-shadow: 0 0 8px var(--amber-bright);
  flex-shrink: 0;
  animation: tvaPulse 2s infinite ease-in-out;
}

