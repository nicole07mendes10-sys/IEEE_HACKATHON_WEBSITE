/* ==========================================================
   FOOTER EVENT-ENDING CONTINUOUS MARQUEE (MOVING RIGHT)
========================================================== */
.footer-marquee-strip {
  width: 100%;
  overflow: hidden;
  background: #090604;
  border-top: 1px solid rgba(217, 169, 58, 0.22);
  border-bottom: 1px solid rgba(217, 169, 58, 0.12);
  padding: 11px 0;
  position: relative;
  box-sizing: border-box;
  user-select: none;
}

.footer-marquee-track {
  display: flex;
  width: max-content;
  white-space: nowrap;
  animation: footerMarqueeScrollRight 28s linear infinite;
  will-change: transform;
}

@keyframes footerMarqueeScrollRight {
  0% {
    transform: translate3d(-50%, 0, 0);
  }
  100% {
    transform: translate3d(0, 0, 0);
  }
}

.footer-marquee-strip:hover .footer-marquee-track {
  animation-play-state: paused;
}

.footer-marquee-sequence {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
}

.f-m-item {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.f-m-item.brand {
  color: var(--amber-bright);
  font-weight: 800;
  text-shadow: 0 0 10px rgba(245, 166, 35, 0.35);
}

.f-m-item.org {
  color: var(--paper-cream);
  font-weight: 600;
  opacity: 0.92;
}

.f-m-sep {
  display: inline-block;
  padding: 0 20px;
  color: rgba(232, 137, 43, 0.55);
  font-weight: 700;
  font-size: 0.85rem;
}

/* Reduced Motion: Stop continuous movement and show single stationary line */
@media (prefers-reduced-motion: reduce) {
  .footer-marquee-track {
    animation: none;
    transform: none;
    width: 100%;
    justify-content: center;
  }
  .footer-marquee-sequence:not(:first-child) {
    display: none;
  }
}

@media (max-width: 640px) {
  .footer-marquee-strip {
    padding: 9px 0;
  }
  .f-m-item {
    font-size: 0.70rem;
    letter-spacing: 0.09em;
  }
  .f-m-sep {
    padding: 0 14px;
  }
}


/* ==========================================================
   MISS MINUTES OVERLAY (ANIMATED RETRO TIME BUREAU MASCOT)
   Conceals the background Gemini AI watermark with genuine alpha
========================================================== */
.miss-minutes-overlay {
  position: fixed;
  z-index: 150;
  pointer-events: auto;
  cursor: pointer;
  transform: translate(-50%, -50%);
  will-change: transform, left, top, width, height;
  user-select: none;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Retro warm bureau drop-shadow */
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
  /* Initial fallback for 16:9 desktop before JS calibration */
  left: 90.59vw;
  top: 83.26vh;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: transparent;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), filter 0.22s ease;
  outline: none;
}

.miss-minutes-overlay:focus-visible {
  outline: 2px solid var(--amber-bright);
  outline-offset: 4px;
}

@media (hover: hover) and (pointer: fine) {
  .miss-minutes-overlay:hover {
    filter: drop-shadow(0 6px 18px var(--amber-glow)) drop-shadow(0 0 14px rgba(232, 137, 43, 0.45));
    transform: translate(-50%, -50%) scale(1.05);
  }
}

.miss-minutes-speech {
  position: absolute;
  bottom: calc(100% - 2px);
  right: 50%;
  background: #1C150F;
  border: 1.5px solid var(--border-brass);
  border-radius: var(--radius-sm);
  padding: 5px 10px;
  font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--amber-bright);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.75);
  z-index: 155;
}

.miss-minutes-speech::after {
  content: '';
  position: absolute;
  top: 100%;
  right: 20px;
  border-width: 5px 5px 0 5px;
  border-style: solid;
  border-color: var(--border-brass) transparent transparent transparent;
}

@media (hover: hover) and (pointer: fine) {
  .miss-minutes-overlay:hover .miss-minutes-speech,
  .miss-minutes-overlay:focus-visible .miss-minutes-speech {
    opacity: 1;
    transform: translateY(0);
  }
}

.miss-minutes-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  pointer-events: none;
  user-select: none;
}

.miss-minutes-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: none;
  pointer-events: none;
  background: transparent;
  border: none;
  outline: none;
}

.miss-minutes-video.is-playing {
  display: block;
}

/* ==========================================================
   TVA TEMPORAL INSPECTION TERMINAL (MINI-GAME MODAL)
   Refined TVA Typography & Interface Design System
========================================================== */

/* TVA Scoped Tokens */
:root {
  --tva-font-mono: 'IBM Plex Mono', 'JetBrains Mono', monospace;
  --tva-font-display: 'Barlow Condensed', 'Bebas Neue', 'Oswald', sans-serif;
  --tva-font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --tva-font-typewriter: 'Special Elite', 'Courier Prime', monospace;
}

.tva-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 920;
  background: rgba(14, 10, 7, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
}

.tva-modal-backdrop.open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.tva-modal-window {
  position: relative;
  width: 100%;
  max-width: 530px;
  max-height: min(90vh, 720px);
  background: #18120C;
  border: 1.5px solid var(--border-brass);
  border-radius: var(--radius-md);
  box-shadow: 0 0 35px rgba(232, 137, 43, 0.22), 0 25px 60px rgba(0, 0, 0, 0.95);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--paper-cream);
  transform: translateY(12px) scale(0.98);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.tva-modal-backdrop.open .tva-modal-window {
  transform: translateY(0) scale(1);
}

/* Subtle CRT scanlines */
.tva-crt-scanlines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%);
  background-size: 100% 4px;
  z-index: 5;
  opacity: 0.32;
}

/* ==========================================================
   A. TERMINAL HEADER & NOTIFICATIONS
========================================================== */
.tva-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  background: #120D09;
  border-bottom: 1.5px solid var(--border-brass);
  z-index: 10;
  position: relative;
  gap: 12px;
}

.tva-header-title-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.tva-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--amber-bright);
  box-shadow: 0 0 8px var(--amber-bright);
  flex-shrink: 0;
  animation: tvaPulse 2s infinite ease-in-out;
}

@keyframes tvaPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.tva-header-title {
  font-family: var(--tva-font-mono);
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--paper-cream);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tva-header-slash {
  color: var(--amber-bright);
  font-weight: 500;
  margin: 0 0.15em;
  opacity: 0.9;
}

.tva-header-controls {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.tva-progress-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(232, 137, 43, 0.12);
  border: 1px solid var(--border-subtle);
  padding: 4px 9px;
  border-radius: var(--radius-sm);
  font-family: var(--tva-font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--amber-bright);
}

.tva-progress-pips {
  display: flex;
  align-items: center;
  gap: 4px;
}

.tva-pip {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--text-dim);
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.tva-pip.active {
  background: var(--amber-bright);
  box-shadow: 0 0 6px var(--amber-bright);
}

.tva-pip.completed {
  background: var(--green-phosphor);
  box-shadow: 0 0 6px var(--green-phosphor);
}

.tva-close-btn {
  width: 32px;
  height: 32px;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  color: var(--text-muted);
  font-size: 1.15rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
