/* ==========================================================
   05. TVA CHRONOLOGICAL EVENT TIMELINE (CONNECTED PROGRESSION)
========================================================== */
.tva-chronological-timeline {
  position: relative;
  max-width: 1040px;
  margin: 36px auto 0;
  padding: 24px 0 48px;
}

/* Continuous Golden Timeline Spine Track (Desktop: Centered) */
.timeline-spine-track {
  position: absolute;
  top: 10px;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  z-index: 1;
  pointer-events: none;
}

.timeline-spine-base {
  position: absolute;
  inset: 0;
  background: rgba(217, 169, 58, 0.22);
}

.timeline-spine-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: linear-gradient(to bottom, #F5A623 0%, #FFD27D 100%);
  box-shadow: 0 0 8px rgba(245, 166, 35, 0.7);
  transition: height 0.2s ease-out;
}

/* Milestones Sequence Container */
.timeline-milestones-list {
  display: flex;
  flex-direction: column;
  gap: 36px;
  position: relative;
  z-index: 2;
}

/* Milestone Item Base & One-Time Progressive Scroll Reveal State */
.timeline-milestone-item {
  position: relative;
  width: calc(50% - 36px);
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

/* Once revealed, permanently remains fully visible; never reverts or re-animates */
.timeline-milestone-item.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

/* Desktop Alternating Rhythm: Left vs Right of Central Spine */
.timeline-milestone-item.milestone-left {
  margin-right: auto;
  margin-left: 0;
}

.timeline-milestone-item.milestone-right {
  margin-left: auto;
  margin-right: 0;
}

/* Milestone Node Anchor (Positioned on the Central Golden Spine) */
.milestone-node-anchor {
  position: absolute;
  top: 36px;
  display: flex;
  align-items: center;
  z-index: 4;
}

.milestone-left .milestone-node-anchor {
  right: -36px;
  transform: translate(50%, -50%);
  flex-direction: row-reverse;
}

.milestone-right .milestone-node-anchor {
  left: -36px;
  transform: translate(-50%, -50%);
  flex-direction: row;
}

/* Circular Node Directly on the Spine */
.milestone-node-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #17120F;
  border: 2px solid rgba(217, 169, 58, 0.45);
  box-shadow: 0 0 4px rgba(0, 0, 0, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.4s ease;
}

.node-inner-core {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #6e5430;
  transition: all 0.4s ease;
}

.milestone-node-stem {
  width: 28px;
  height: 1.5px;
  background: rgba(217, 169, 58, 0.35);
  transition: all 0.4s ease;
}

/* Node Illumination on Reveal */
.timeline-milestone-item.is-revealed .milestone-node-dot {
  border-color: #FFD27D;
  background: #2b1d12;
  box-shadow: 0 0 12px rgba(245, 166, 35, 0.75);
}

.timeline-milestone-item.is-revealed .node-inner-core {
  background: #FFD27D;
  box-shadow: 0 0 6px #F5A623;
}

.timeline-milestone-item.is-revealed .milestone-node-stem {
  background: rgba(245, 166, 35, 0.7);
  box-shadow: 0 0 6px rgba(245, 166, 35, 0.4);
}

/* Final Milestone Highlighted Node */
.timeline-milestone-item.final-phase.is-revealed .milestone-node-dot {
  border-color: #FFF2D1;
  background: #E8892B;
  box-shadow: 0 0 16px rgba(255, 210, 125, 0.9);
}

.timeline-milestone-item.final-phase.is-revealed .node-inner-core {
  background: #FFFFFF;
  box-shadow: 0 0 8px #FFFFFF;
}

/* Milestone Information Box */
.milestone-card-box {
