/* 7. Miss Minutes Centred Registration Modal */
.mm-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(10, 8, 6, 0.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
}

.mm-modal-backdrop.is-open {
  display: flex;
}

body.modal-blurred-open main,
body.modal-blurred-open header,
body.modal-blurred-open footer,
body.modal-blurred-open aside {
  filter: blur(4px);
  transition: filter 0.25s ease;
  pointer-events: none;
}

.mm-modal-card {
  position: relative;
  background: radial-gradient(circle at 50% 20%, #251b13 0%, #17110c 70%, #110d0a 100%);
  border: 2px solid var(--amber-bright);
  border-radius: var(--radius-md);
  padding: 34px 28px 30px;
  width: 100%;
  max-width: 440px;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.9), 0 0 35px rgba(232, 137, 43, 0.25);
  animation: mmModalEnter 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes mmModalEnter {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(12px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.mm-modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 34px;
  height: 34px;
  border-radius: var(--radius-sm);
  background: #241a12;
  border: 1px solid var(--border-brass);
  color: var(--paper-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 1rem;
  transition: var(--transition-fast);
}

.mm-modal-close:hover {
  background: #332314;
  color: var(--amber-bright);
  border-color: var(--amber-bright);
}

.mm-modal-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--amber-bright);
  text-transform: uppercase;
  margin-bottom: 6px;
}

.mm-badge-dot {
