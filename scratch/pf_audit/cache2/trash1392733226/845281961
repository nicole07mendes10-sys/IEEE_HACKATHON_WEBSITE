  line-height: 1.6;
}

.fee-calculation-box {
  background: #120d09;
  border: 1.5px solid var(--border-brass);
  border-radius: var(--radius-sm);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5), 0 4px 16px rgba(0, 0, 0, 0.35);
}

.fee-box-title {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--paper-cream);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-bottom: 1px dashed var(--border-dim);
  padding-bottom: 12px;
  margin-bottom: 16px;
}

.fee-amount-display {
  display: flex;
  align-items: baseline;
  padding: 4px 0 0;
}

.fee-amount-val {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 3.8vw, 3rem);
  font-weight: 700;
  color: var(--amber-bright);
  letter-spacing: 0.04em;
  line-height: 1.1;
  text-shadow: 0 0 18px rgba(245, 166, 35, 0.4);
}

.fee-row {
  display: none;
}

.fee-calc-formula,
.fee-transparency-memo {
  display: none;
}

/* ==========================================================
   07. ACCOMMODATION CONTAINER & STAT CARDS
========================================================== */
.accommodation-container {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.accommodation-notes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

.quarters-stat-card {
  background: #18120c;
  border: 2px solid var(--border-dim);
  border-radius: var(--radius-md);
  padding: 24px 20px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: border-color var(--transition-smooth), transform var(--transition-smooth);
}

.quarters-stat-card:hover {
  transform: translateY(-3px);
  border-color: var(--border-brass);
}

.quarters-stat-card.highlight-card {
  border-color: var(--amber-bright);
  box-shadow: 0 8px 25px rgba(232, 137, 43, 0.25);
}

.stat-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 4px;
  background: rgba(217, 169, 58, 0.08);
  border: 1px solid rgba(217, 169, 58, 0.28);
  color: var(--amber-bright);
  margin-bottom: 14px;
  transition: all 0.2s ease;
}

.quarters-stat-card:hover .stat-icon {
  border-color: var(--amber-bright);
  background: rgba(217, 169, 58, 0.16);
  box-shadow: 0 0 10px rgba(245, 166, 35, 0.3);
}

.quarters-stat-card.highlight-card .stat-icon {
  background: rgba(245, 166, 35, 0.18);
  border-color: var(--amber-bright);
  box-shadow: 0 0 10px rgba(245, 166, 35, 0.3);
}

.stat-svg {
  display: block;
}

.contact-link-icon,
.maps-icon,
.crew-phone-icon,
.standby-icon,
.date-icon,
.tva-feedback-icon,
.tva-lock-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  vertical-align: middle;
}
.contact-sub-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.btn-open-maps {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.stat-heading {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  font-weight: bold;
  letter-spacing: 0.06em;
  color: var(--paper-cream);
}

.stat-body {
  font-family: var(--font-typewriter);
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.5;
}

.accommodation-details-panel {
  background: #130d08;
  border: 1.5px solid var(--border-brass);
  border-radius: var(--radius-sm);
  padding: 24px 28px;
}

.panel-section-title {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--amber-bright);
  letter-spacing: 0.08em;
  border-bottom: 1px dashed var(--border-dim);
  padding-bottom: 8px;
  margin-bottom: 18px;
}

.specs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 18px;
}

.spec-unit {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.spec-unit.span-two {
  grid-column: 1 / -1;
}

.spec-label {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-dim);
  letter-spacing: 0.06em;
}

.spec-val-pending {
  font-family: var(--font-typewriter);
  font-size: 0.9rem;
  color: var(--paper-cream);
}

/* ==========================================================
   08. JUDGING AND RECOGNITION
========================================================== */
.judging-protocol-wrapper {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.judging-bench-notice {
  background: #1a130c;
  border: 1.5px solid var(--border-brass);
  border-radius: var(--radius-md);
  padding: 20px 24px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
}

.bench-notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.bench-tag {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--amber-bright);
  font-weight: bold;
  letter-spacing: 0.08em;
}

.bench-badge {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--mustard-secondary);
  background: rgba(217, 169, 58, 0.12);
  padding: 2px 8px;
  border-radius: 2px;
}

.bench-note {
  font-family: var(--font-typewriter);
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.55;
}

.evaluation-pillars-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 20px;
}

.pillar-card {
  background: #17100b;
  border: 1.5px solid var(--border-dim);
  border-radius: var(--radius-md);
  padding: 24px 20px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: border-color var(--transition-smooth), transform var(--transition-smooth);
}

.pillar-card:hover {
  transform: translateY(-3px);
  border-color: var(--amber-bright);
}

.pillar-num {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--amber-bright);
  letter-spacing: 0.08em;
}

.pillar-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  color: var(--paper-cream);
  line-height: 1.15;
}

.pillar-desc {
  font-family: var(--font-typewriter);
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.5;
}

.recognition-standby-panel {
  background: #120d08;
  border: 1px dashed var(--border-brass);
  border-radius: var(--radius-sm);
  padding: 22px 28px;
  text-align: center;
}

.rec-title {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--amber-bright);
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.rec-sub {
  font-family: var(--font-typewriter);
  font-size: 0.9rem;
  color: var(--text-muted);
  max-width: 680px;
  margin: 0 auto;
}

/* ==========================================================
   11. CONTACT & VENUE
========================================================== */
.contact-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
}

.contact-dossier-card {
  background: #18120c;
  border: 2px solid var(--border-brass);
  border-radius: var(--radius-md);
  padding: 26px 22px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;
  transition: transform var(--transition-smooth);
}

.contact-dossier-card:hover {
  transform: translateY(-3px);
}

.contact-card-tag {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  color: var(--amber-bright);
  letter-spacing: 0.08em;
}

.contact-card-title {
  font-family: var(--font-display);
  font-size: 1.45rem;
  color: var(--paper-cream);
  line-height: 1.2;
}

.contact-card-body {
  font-family: var(--font-typewriter);
  font-size: 0.92rem;
  color: var(--text-muted);
  line-height: 1.5;
  flex-grow: 1;
}

.contact-action-link {
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px dashed var(--border-dim);
}

.contact-sub-link {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--mustard-secondary);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.contact-sub-link:hover {
  color: var(--amber-bright);
  text-decoration: underline;
}

/* ==========================================================
   8. SPONSORS — AUTHORIZED PARTNERS (PINBOARD CLEARANCE CARDS)
========================================================== */
.sponsors-pinboard-deck {
  background: #1c150f;
  border: 2px solid var(--border-brass);
  border-radius: var(--radius-md);
  padding: 44px 32px 36px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
  position: relative;
  overflow: visible;
}

.pinboard-cork-mesh {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background-image: radial-gradient(rgba(217, 169, 58, 0.08) 1px, transparent 0);
  background-size: 16px 16px;
  pointer-events: none;
}

.sponsors-tier-wrapper {
  display: flex;
  flex-direction: column;
  gap: 32px;
  position: relative;
  z-index: 2;
  margin-bottom: 36px;
  width: 100%;
  align-items: center;
}

.tier-section-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
}

.tier-divider-label {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.12em;
  color: var(--mustard-secondary);
  text-transform: uppercase;
  background: #14100c;
  padding: 4px 16px;
  border: 1px dashed var(--border-subtle);
  border-radius: 20px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
}

/* Base Authorization Card */
.auth-clearance-card {
  background: var(--paper-cream);
  color: var(--ink-charcoal);
  border-radius: var(--radius-sm);
  padding: 22px 18px 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  font-family: var(--font-typewriter);
  text-decoration: none;
  transition: box-shadow var(--transition-smooth), transform 0.25s ease;
  opacity: 0;
  box-sizing: border-box;
  overflow: visible;
}

.bureau-section.stamped .auth-clearance-card {
  opacity: 1;
}

.auth-clearance-card:hover {
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.6);
  z-index: 10;
}

.card-pushpin-head {
  position: absolute;
  top: -9px;
  left: 50%;
  transform: translateX(-50%);
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--stamp-red);
  border: 2px solid #fff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  pointer-events: none;
  z-index: 4;
}

.card-auth-number {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  color: #7a6a58;
  margin-bottom: 10px;
}

/* Logo Box */
.card-logo-container {
  width: 100%;
  height: 70px;
  background: #dfd4be;
  border: 1.5px dashed #a89a84;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  overflow: hidden;
  filter: grayscale(100%);
  opacity: 0.85;
  transition: filter var(--transition-smooth), opacity var(--transition-smooth);
}

.auth-clearance-card:hover .card-logo-container {
  filter: grayscale(0%);
  opacity: 1;
  border-color: var(--amber-primary);
}

.card-logo-placeholder-text {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: bold;
  letter-spacing: 0.15em;
  color: #5c4e40;
}

.card-sponsor-name {
  font-family: var(--font-display);
  font-size: 1.45rem;
  line-height: 1.1;
  color: #1a140f;
  margin-bottom: 6px;
}

/* Card Clearance Footer Strip: Separates Badge and Approved Stamp to Prevent Overlaps */
.card-clearance-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: auto;
  padding-top: 10px;
  gap: 8px;
  border-top: 1px dashed rgba(168, 154, 132, 0.35);
  box-sizing: border-box;
}

.card-tier-stamp {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  font-weight: bold;
  padding: 3px 8px;
  border-radius: 2px;
  text-transform: uppercase;
  white-space: nowrap;
}

.badge-title {
  background: rgba(232, 137, 43, 0.15);
  border: 1.5px solid var(--stamp-amber);
  color: #9c4d08;
}

.badge-gold {
  background: rgba(217, 169, 58, 0.15);
  border: 1.5px solid var(--mustard-secondary);
  color: #7a5c10;
}

.badge-silver {
  background: rgba(120, 110, 100, 0.15);
  border: 1.5px solid #887a6a;
  color: #50463c;
}

/* Approved Watermark Stamp */
.card-approved-stamp {
  font-family: var(--font-display);
  font-size: 0.95rem;
  letter-spacing: 0.08em;
  color: var(--stamp-green);
  border: 1.5px dashed var(--stamp-green);
  padding: 1px 6px;
  transform: rotate(-6deg);
  opacity: 0.9;
  pointer-events: none;
  white-space: nowrap;
  line-height: 1.1;
  background: rgba(61, 140, 64, 0.06);
}

/* Tier Sizes & Symmetrical Pyramid Alignment */

/* 1. Title Partner (1 Large Centered Card) */
.tier-title-container {
  width: 100%;
  max-width: 380px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
}

.tier-title-card {
  width: 100%;
  padding: 24px 22px 18px;
}

.tier-title-card .card-logo-container {
  height: 84px;
}

.tier-title-card .card-sponsor-name {
  font-size: 1.75rem;
}

/* 2. Gold Partners (2 Medium Centered Cards) */
.tier-gold-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(260px, 340px));
  gap: 24px;
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  justify-content: center;
}

.tier-gold-card {
  padding: 22px 18px 16px;
}

.tier-gold-card .card-logo-container {
  height: 72px;
}

.tier-gold-card .card-sponsor-name {
  font-size: 1.45rem;
}

/* 3. Silver Partners (3 Balanced Centered Cards) */
.tier-silver-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(210px, 270px));
  gap: 20px;
  width: 100%;
  max-width: 860px;
  margin: 0 auto;
  justify-content: center;
}

.tier-silver-card {
  padding: 20px 16px 14px;
}

.tier-silver-card .card-logo-container {
  height: 62px;
}

.tier-silver-card .card-sponsor-name {
  font-size: 1.25rem;
}

/* Partnership Requisition Call to Action */
.partnership-requisition-panel {
  background: #140e0a;
  border: 1.5px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
  position: relative;
  z-index: 2;
}

.partnership-notice-text {
  font-family: var(--font-typewriter);
  color: var(--text-muted);
  max-width: 580px;
}

.notice-title {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  color: var(--amber-bright);
  margin-bottom: 4px;
  font-weight: bold;
}

.partnership-actions-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

/* ==========================================================
   9. FAQ — MANILA CASE FILES ACCORDION
========================================================== */
.case-files-accordion {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.case-folder-unit {
  background: #1c150f;
  border: 1px solid var(--border-brass);
  border-radius: var(--radius-sm);
  overflow: hidden;
  transition: var(--transition-fast);
}

.case-folder-unit.open {
  border-color: var(--amber-bright);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
}

.folder-tab-bar {
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  background: #241a12;
  user-select: none;
}

.folder-case-num {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--amber-bright);
  margin-right: 12px;
}

.folder-query-title {
  font-family: var(--font-typewriter);
  font-size: 1.05rem;
  color: var(--paper-cream);
  font-weight: bold;
}

.folder-content-drawer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #16100b;
}

.case-folder-unit.open .folder-content-drawer {
  max-height: 300px;
}

.folder-drawer-inner {
  padding: 20px 24px;
  font-family: var(--font-typewriter);
  font-size: 0.95rem;
  color: var(--text-muted);
  line-height: 1.5;
  border-top: 1px dashed var(--border-subtle);
  position: relative;
}

.answered-stamp-badge {
  position: absolute;
  right: 24px;
  top: 18px;
  font-family: var(--font-display);
  font-size: 1.2rem;
  letter-spacing: 0.1em;
  color: var(--green-phosphor);
  border: 2px dashed var(--green-phosphor);
  padding: 2px 10px;
  transform: rotate(-5deg);
  opacity: 0.8;
}

/* ==========================================================
   FINAL TRANSMISSION // OVERCLOCK 2027 (REDESIGNED FOOTER)
   Functional architecture adapted from reference, rendered in TVA aesthetic.
========================================================== */
.tva-event-footer {
  background: radial-gradient(ellipse at 50% 0%, #150e09 0%, #0a0705 100%);
  border-top: 3px solid var(--border-brass);
  padding: 80px 0 0;
  position: relative;
  z-index: 10;
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.85);
  overflow: hidden;
}

.footer-inner-container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 24px 36px;
  box-sizing: border-box;
}

.footer-transmission-header {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 48px;
}

.footer-main-heading {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  letter-spacing: 0.08em;
  color: var(--paper-cream);
  margin: 12px 0 12px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
}

.footer-lead-text {
  font-family: var(--font-typewriter);
  font-size: 0.95rem;
  color: var(--text-muted);
  line-height: 1.55;
  margin: 0 auto;
}

/* Simplified 2-Pillar Footer Grid: Venue/Map & Crew */
.footer-control-grid,
.footer-simplified-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  margin-bottom: 36px;
}

@media (max-width: 820px) {
  .footer-control-grid,
  .footer-simplified-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

.footer-panel {
  background: rgba(22, 16, 11, 0.88);
  border: 1px solid rgba(217, 169, 58, 0.28);
  border-radius: var(--radius-md);
  padding: 24px 22px;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6),
              inset 0 0 12px rgba(217, 169, 58, 0.03);
  transition: border-color 0.25s ease;
}

.footer-panel:hover {
  border-color: rgba(232, 137, 43, 0.45);
}

.panel-header-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--amber-bright);
  text-transform: uppercase;
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px dashed rgba(217, 169, 58, 0.2);
}

.panel-lamp {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--amber-bright);
  box-shadow: 0 0 6px var(--amber-bright);
}

/* Panel 1: Venue & Map */
.footer-map-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.map-viewport-frame {
  position: relative;
  width: 100%;
  height: 160px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1.5px solid rgba(217, 169, 58, 0.35);
  background: #0d0906;
  box-shadow: inset 0 0 14px rgba(0, 0, 0, 0.8);
}

.footer-map-embed {
  width: 100%;
  height: 100%;
  border: none;
  filter: contrast(1.08) brightness(0.85) saturate(0.8);
  transition: filter 0.3s ease;
